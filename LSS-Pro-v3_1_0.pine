string GRP_WR = "═══ Win-Rate Tracker ═══"
bool   IN_SHOW_WR     = input.bool(true,  "Show Win-Rate Table",   group = GRP_WR)
string IN_WR_POS      = input.string(POS_TR, "Position",
     options = [POS_TL, POS_TR, POS_BL, POS_BR], group = GRP_WR)

// ── Debug ─────────────────────────────────────────────────────
string GRP_DBG = "═══ Debug ═══"
bool IN_SHOW_DEBUG = input.bool(false, "Show Debug Label", group = GRP_DBG)

// ============================================================
// SECTION 3 — HELPER FUNCTIONS
// ============================================================

fn_fmt_vol(float v) =>
    v >= 1000000000 ? str.tostring(v / 1000000000, "#.##") + "B" :
     v >= 1000000    ? str.tostring(v / 1000000, "#.##") + "M" :
     v >= 1000       ? str.tostring(v / 1000, "#.##") + "K" :
     str.tostring(v, "#")

fn_trend_color(string trend) =>
    trend == TREND_BULL ? COLOR_BULL :
     trend == TREND_BEAR ? COLOR_BEAR :
     COLOR_NEUTRAL

fn_resolve_htf() =>
    tf = timeframe.period
    tf == "1"  ? TF_15M :
     tf == "3"  ? TF_30M :
     tf == "5"  ? TF_1H  :
     tf == "15" ? TF_4H  :
     tf == "30" ? TF_4H  :
     tf == "60" ? TF_1D  :
     TF_1D

fn_table_pos(string pos) =>
    pos == POS_TL ? position.top_right   :
     pos == POS_TR ? position.top_left    :
     pos == POS_BL ? position.bottom_left :
     position.bottom_right

fn_htf_label(string tf) =>
    tf == TF_1D  ? "Daily" :
     tf == TF_4H  ? "4H"    :
     tf == TF_1H  ? "1H"    :
     tf == TF_30M ? "30m"   :
     tf == TF_15M ? "15m"   :
     tf

// FVG transparency based on grade — higher values = more transparent = lighter fill
fn_fvg_transp(string grade) =>
    grade == FVG_GRADE_L ? 88 :
     grade == FVG_GRADE_M ? 91 :
     94

// ============================================================
// SECTION 4 — SESSION ENGINE
// ============================================================

bool SES_INDIA_ACTIVE  = IN_SES_INDIA  and time(timeframe.period, "0345-1000", "UTC") != 0
bool SES_LONDON_ACTIVE = IN_SES_LONDON and time(timeframe.period, "0800-1630", "UTC") != 0
bool SES_NY_ACTIVE     = IN_SES_NY     and time(timeframe.period, "1430-2100", "UTC") != 0
bool SES_ASIA_ACTIVE   = IN_SES_ASIA   and time(timeframe.period, "0000-0800", "UTC") != 0

string ACTIVE_SESSION =
     SES_INDIA_ACTIVE  ? SES_INDIA    :
     SES_LONDON_ACTIVE ? SES_LONDON   :
     SES_NY_ACTIVE     ? SES_NEW_YORK :
     SES_ASIA_ACTIVE   ? SES_ASIA     :
     SES_NONE

color ACTIVE_SESSION_COLOR =
     SES_INDIA_ACTIVE  ? color.new(#FF9F0A, 0) :
     SES_LONDON_ACTIVE ? color.new(#30D158, 0) :
     SES_NY_ACTIVE     ? color.new(#5AC8FA, 0) :
     SES_ASIA_ACTIVE   ? color.new(#BF5AF2, 0) :
     COLOR_DIM

// ── Kill Zones ───────────────────────────────────────────────
// Highest-probability institutional order flow windows
// London Open: 08:00–10:00 UTC | NY Open: 13:30–15:00 UTC | India Open: 03:45–04:30 UTC
bool KZ_LONDON_OPEN = not na(time(timeframe.period, "0800-1000", "UTC"))
bool KZ_NY_OPEN     = not na(time(timeframe.period, "1330-1500", "UTC"))
bool KZ_INDIA_OPEN  = not na(time(timeframe.period, "0345-0430", "UTC"))
bool IN_KILL_ZONE   = KZ_LONDON_OPEN or KZ_NY_OPEN or KZ_INDIA_OPEN

string KILL_ZONE_NAME = KZ_LONDON_OPEN ? "London KZ" :
     KZ_NY_OPEN     ? "NY KZ"     :
     KZ_INDIA_OPEN  ? "India KZ"  : "—"

string RESOLVED_HTF = IN_HTF_AUTO ? fn_resolve_htf() : IN_HTF_MANUAL

[HTF_OPEN, HTF_HIGH, HTF_LOW, HTF_CLOSE] =
     request.security(syminfo.tickerid, RESOLVED_HTF,
         [open, high, low, close],
         lookahead = barmerge.lookahead_off)

// ============================================================
// SECTION 6 — HTF STRUCTURE ENGINE  (v3.0.0)
// ============================================================
// Architecture:
//   Replaces the EMA 50/200 crossover proxy with real HTF swing
//   high / swing low structure. RESOLVED_HTF is already set in
//   Section 4 (auto or manual). HTF OHLC is already pulled there.
//
//   Method:
//     • Pull ta.pivothigh / ta.pivotlow on the HTF via request.security.
//     • Track the most-recent confirmed HTF swing high (HTF_LAST_SH)
//       and swing low (HTF_LAST_SL) on the LTF chart.
//     • Determine HTF_BIAS:
//         Bullish — HTF close has broken ABOVE HTF_LAST_SH
//         Bearish — HTF close has broken BELOW HTF_LAST_SL
//         Neutral — structure not yet established or equal
//
//   Pivot left/right legs = 3 bars each on the HTF.
//   This gives reliable, non-repainting HTF structure.
//
//   EMA 50 / 200 are retained for visual reference only.
//   They no longer drive any scoring logic.
//
// Outputs:
//   HTF_LAST_SH   — price of last confirmed HTF swing high
//   HTF_LAST_SL   — price of last confirmed HTF swing low
//   HTF_BIAS      — "Bullish" / "Bearish" / "—"
//   HTF_BIAS_COLOR — display colour
//   HTF_BIAS_CHANGED — true on the bar HTF_BIAS flips
// ============================================================

// ── 6.1 Pull HTF pivot highs and lows ────────────────────────
// Pine v6: request.security with a tuple expression.
// lookahead_off → no future leak; pivots confirm 3 bars after the pivot bar.
[htf_ph_raw, htf_pl_raw] = request.security(
     syminfo.tickerid, RESOLVED_HTF,
     [ta.pivothigh(high, 3, 3), ta.pivotlow(low, 3, 3)],
     lookahead = barmerge.lookahead_off)

// ── 6.2 Track last confirmed HTF swing high / low ─────────────
// var preserves value across LTF bars — only updates when a new
// HTF pivot fires (non-na value arrives).
var float HTF_LAST_SH = na
var float HTF_LAST_SL = na

if not na(htf_ph_raw)
    HTF_LAST_SH := htf_ph_raw
if not na(htf_pl_raw)
    HTF_LAST_SL := htf_pl_raw

// ── 6.3 Derive HTF bias from structure breaks ─────────────────
// A bullish bias is established when HTF close exceeds the last SH.
// A bearish bias is established when HTF close falls below the last SL.
// If neither condition is met (e.g. first few bars, sideways), bias = none.
string HTF_BIAS =
     not na(HTF_LAST_SH) and HTF_CLOSE > HTF_LAST_SH ? HTF_BIAS_BULL :
     not na(HTF_LAST_SL) and HTF_CLOSE < HTF_LAST_SL ? HTF_BIAS_BEAR :
     HTF_BIAS_NONE

color HTF_BIAS_COLOR =
     HTF_BIAS == HTF_BIAS_BULL ? COLOR_BULL :
     HTF_BIAS == HTF_BIAS_BEAR ? COLOR_BEAR :
     COLOR_DIM

bool HTF_BIAS_CHANGED = HTF_BIAS != HTF_BIAS[1]

// ── 6.4 EMA 50 / 200 — visual reference only (v3.0.0) ─────────
// These no longer feed into scoring. Kept so traders can still
// display them as an optional reference overlay.
float EMA50  = ta.ema(close, EMA_FAST_LEN)
float EMA200 = ta.ema(close, EMA_SLOW_LEN)

// TREND_STATE kept as a passthrough alias for the debug label and
// alert condition — mapped from HTF_BIAS so no downstream breakage.
string TREND_STATE   = HTF_BIAS
color  TREND_COLOR   = HTF_BIAS_COLOR
bool   TREND_CHANGED = HTF_BIAS_CHANGED

// ATR(14) — declared here so both Section 6B and Section 13 can reference it
float ATR_VAL = ta.atr(14)

// ============================================================
// SECTION 6B — HTF FVG & ORDER BLOCK ENGINE  (v3.0.0)
// ============================================================
// Architecture:
//   Detects FVGs and Order Blocks on the higher timeframe using
//   the same 3-candle logic as Section 13, but applied to HTF
//   OHLC bars already pulled via request.security in Section 4.
//
//   HTF FVG (Fair Value Gap):
//     Bull HTF FVG: HTF_HIGH[2] < HTF_LOW[0]  → upward gap
//     Bear HTF FVG: HTF_LOW[2]  > HTF_HIGH[0] → downward gap
//     CE = midpoint of the gap zone
//
//   HTF Order Block (OB):
//     Bull HTF OB: last bearish HTF candle before a bull HTF FVG forms
//     Bear HTF OB: last bullish HTF candle before a bear HTF FVG forms
//     Zone = candle body (open → close)
//
//   Detection fires on the LTF bar where the HTF pattern completes.
//   request.security already provides confirmed HTF bars — no repaint.
//
//   Mitigation: price crosses the CE of the HTF FVG → Tested
//               price fills the entire HTF FVG → Mitigated
//               price closes through the HTF OB body → Mitigated
//
// Outputs (used by Section 15 scoring and Section 9 dashboard):
//   HTF_FVG_BULL_ACTIVE  — an unmitigated bullish HTF FVG exists
//   HTF_FVG_BULL_CE_NEAR — current price is within 0.5×ATR of bull CE
//   HTF_FVG_BEAR_ACTIVE  — an unmitigated bearish HTF FVG exists
//   HTF_FVG_BEAR_CE_NEAR — current price is within 0.5×ATR of bear CE
//   HTF_OB_BULL_ACTIVE   — an unmitigated bullish HTF OB zone exists
//   HTF_OB_BULL_NEAR     — price is inside or touching the bull HTF OB
//   HTF_OB_BEAR_ACTIVE   — an unmitigated bearish HTF OB zone exists
//   HTF_OB_BEAR_NEAR     — price is inside or touching the bear HTF OB
// ============================================================

// ── 6B.1 HTF FVG Detection ───────────────────────────────────
// Use HTF bars already fetched in Section 4: HTF_HIGH, HTF_LOW, HTF_CLOSE, HTF_OPEN
// [0] = current HTF bar, [1] = previous, [2] = bar before that
// Pattern fires when the current HTF bar completes the 3-candle gap.

bool htf_fvg_bull_detected = HTF_HIGH[2] < HTF_LOW[0]  and HTF_CLOSE[1] > HTF_OPEN[1]
bool htf_fvg_bear_detected = HTF_LOW[2]  > HTF_HIGH[0] and HTF_CLOSE[1] < HTF_OPEN[1]

// Only fire on the bar where HTF values change (new HTF candle completed)
bool htf_bar_changed = HTF_CLOSE != HTF_CLOSE[1]

// ── 6B.2 HTF FVG State Storage (1 active FVG per side, FIFO) ──
var float  HTF_FVG_BULL_TOP   = na  // low[0] of the HTF pattern
var float  HTF_FVG_BULL_BOT   = na  // high[2] of the HTF pattern
var float  HTF_FVG_BULL_CE    = na  // midpoint
var string HTF_FVG_BULL_STATE = "None"
var float  HTF_FVG_BULL_OB_TOP = na  // HTF OB body top (bull OB = last bear HTF candle open)
var float  HTF_FVG_BULL_OB_BOT = na  // HTF OB body bottom (close of that bear candle)

var float  HTF_FVG_BEAR_TOP   = na
var float  HTF_FVG_BEAR_BOT   = na
var float  HTF_FVG_BEAR_CE    = na
var string HTF_FVG_BEAR_STATE = "None"
var float  HTF_FVG_BEAR_OB_TOP = na  // HTF OB body top (bull HTF candle close)
var float  HTF_FVG_BEAR_OB_BOT = na  // HTF OB body bottom (bull HTF candle open)

// ── 6B.3 Register new HTF FVGs when a fresh HTF bar arrives ──
if htf_bar_changed and htf_fvg_bull_detected
    HTF_FVG_BULL_TOP   := HTF_LOW[0]
    HTF_FVG_BULL_BOT   := HTF_HIGH[2]
    HTF_FVG_BULL_CE    := (HTF_LOW[0] + HTF_HIGH[2]) / 2.0
    HTF_FVG_BULL_STATE := FVG_FRESH
    // HTF OB = candle[2] search: last bearish HTF candle before the gap
    // We approximate using HTF_OPEN[2]/HTF_CLOSE[2] — the gap initiator bar
    if HTF_CLOSE[2] < HTF_OPEN[2]
        HTF_FVG_BULL_OB_TOP := HTF_OPEN[2]
        HTF_FVG_BULL_OB_BOT := HTF_CLOSE[2]
    else
        // impulse bar was bullish — OB is not meaningful, clear it
        HTF_FVG_BULL_OB_TOP := na
        HTF_FVG_BULL_OB_BOT := na

if htf_bar_changed and htf_fvg_bear_detected
    // Bear HTF FVG: HTF_LOW[2] > HTF_HIGH[0] → gap between low of bar[2] and high of bar[0]
    HTF_FVG_BEAR_TOP   := HTF_LOW[2]   // bottom of bar[2] — top of the gap zone
    HTF_FVG_BEAR_BOT   := HTF_HIGH[0]  // top of bar[0]  — bottom of the gap zone
    HTF_FVG_BEAR_CE    := (HTF_LOW[2] + HTF_HIGH[0]) / 2.0
    HTF_FVG_BEAR_STATE := FVG_FRESH
    // HTF OB = last bullish HTF candle — use bar[2] as initiator
    if HTF_CLOSE[2] > HTF_OPEN[2]
        HTF_FVG_BEAR_OB_TOP := HTF_CLOSE[2]
        HTF_FVG_BEAR_OB_BOT := HTF_OPEN[2]
    else
        HTF_FVG_BEAR_OB_TOP := na
        HTF_FVG_BEAR_OB_BOT := na

// ── 6B.4 HTF FVG State Updates (CE touch / Mitigation) ───────
// Check on every LTF bar whether price has interacted with the HTF FVG zones.

if HTF_FVG_BULL_STATE != "None" and HTF_FVG_BULL_STATE != FVG_MITIGATED
    if not na(HTF_FVG_BULL_CE) and low <= HTF_FVG_BULL_CE
        HTF_FVG_BULL_STATE := FVG_CE_TOUCH
    if not na(HTF_FVG_BULL_BOT) and low <= HTF_FVG_BULL_BOT
        HTF_FVG_BULL_STATE := FVG_MITIGATED  // fully filled

if HTF_FVG_BEAR_STATE != "None" and HTF_FVG_BEAR_STATE != FVG_MITIGATED
    if not na(HTF_FVG_BEAR_CE) and high >= HTF_FVG_BEAR_CE
        HTF_FVG_BEAR_STATE := FVG_CE_TOUCH
    if not na(HTF_FVG_BEAR_TOP) and high >= HTF_FVG_BEAR_TOP
        HTF_FVG_BEAR_STATE := FVG_MITIGATED

// HTF OB mitigation — price closes through the OB body
if not na(HTF_FVG_BULL_OB_BOT) and close < HTF_FVG_BULL_OB_BOT
    HTF_FVG_BULL_OB_TOP := na
    HTF_FVG_BULL_OB_BOT := na

if not na(HTF_FVG_BEAR_OB_TOP) and close > HTF_FVG_BEAR_OB_TOP
    HTF_FVG_BEAR_OB_TOP := na
    HTF_FVG_BEAR_OB_BOT := na

// ── 6B.5 Derived Output Booleans (consumed by Section 15) ────
bool HTF_FVG_BULL_ACTIVE  = HTF_FVG_BULL_STATE != "None" and HTF_FVG_BULL_STATE != FVG_MITIGATED
bool HTF_FVG_BEAR_ACTIVE  = HTF_FVG_BEAR_STATE != "None" and HTF_FVG_BEAR_STATE != FVG_MITIGATED
bool HTF_FVG_BULL_CE_NEAR = HTF_FVG_BULL_ACTIVE and not na(HTF_FVG_BULL_CE) and
     math.abs(close - HTF_FVG_BULL_CE) <= ATR_VAL * 0.5
bool HTF_FVG_BEAR_CE_NEAR = HTF_FVG_BEAR_ACTIVE and not na(HTF_FVG_BEAR_CE) and
     math.abs(close - HTF_FVG_BEAR_CE) <= ATR_VAL * 0.5

bool HTF_OB_BULL_ACTIVE = not na(HTF_FVG_BULL_OB_TOP) and not na(HTF_FVG_BULL_OB_BOT)
bool HTF_OB_BEAR_ACTIVE = not na(HTF_FVG_BEAR_OB_TOP) and not na(HTF_FVG_BEAR_OB_BOT)
bool HTF_OB_BULL_NEAR   = HTF_OB_BULL_ACTIVE and
     low  <= HTF_FVG_BULL_OB_TOP and high >= HTF_FVG_BULL_OB_BOT
bool HTF_OB_BEAR_NEAR   = HTF_OB_BEAR_ACTIVE and
     low  <= HTF_FVG_BEAR_OB_TOP and high >= HTF_FVG_BEAR_OB_BOT

// ── 6B.6 HTF FVG Visuals — intentionally omitted ─────────────
// HTF FVGs span many LTF candles and are confusing as chart drawings.
// All HTF context is surfaced via the dashboard (rows 6–7) and scoring only.

// ============================================================
// SECTION 7 — CONTEXT ENGINE
// ============================================================

[PD_HIGH, PD_LOW] =
     request.security(syminfo.tickerid, "1D",
         [high[1], low[1]],
         lookahead = barmerge.lookahead_off)

string MARKET_CONTEXT =
     close > PD_HIGH ? CTX_ABOVE :
     close < PD_LOW  ? CTX_BELOW :
     CTX_INSIDE

color CONTEXT_COLOR =
     MARKET_CONTEXT == CTX_ABOVE ? COLOR_BULL  :
     MARKET_CONTEXT == CTX_BELOW ? COLOR_BEAR  :
     COLOR_NEUTRAL

// ============================================================
// SECTION 8 — VISUAL ENGINE
// ============================================================

plot(IN_SHOW_EMA50  ? EMA50  : na, title = "EMA 50",
     color = IN_COLOR_EMA50,  linewidth = 1)
plot(IN_SHOW_EMA200 ? EMA200 : na, title = "EMA 200",
     color = IN_COLOR_EMA200, linewidth = 1)
plot(IN_SHOW_PDH    ? PD_HIGH : na, title = "PDH",
     color = IN_COLOR_PDH, linewidth = 1, style = plot.style_stepline)
plot(IN_SHOW_PDH    ? PD_LOW  : na, title = "PDL",
     color = IN_COLOR_PDL, linewidth = 1, style = plot.style_stepline)

// ============================================================
// SECTION 11.5 — NEWS CALENDAR ENGINE  (v2.7.0)
// ============================================================
// Architecture:
//   Tracks recurring high-impact crude oil events by UTC time.
//   Three phases per event:
//     PRE  : IN_NEWS_PRE_MINS before release  → block new setups
//     LIVE : 0–IN_NEWS_POST_MINS after release → still blocked, watch sweep
//     POST : after LIVE window ends            → resume, bonus sweep scoring
//
//   Hardcoded weekly events (UTC):
//     EIA Crude Inventory  — Wednesday 14:30 UTC (8:00 PM IST)
//     API Crude Inventory  — Tuesday   20:30 UTC (2:00 AM IST next day)
//
//   Manual override: IN_NEWS_MANUAL blocks regardless of time.
//
// Outputs:
//   NEWS_PHASE   — "Clear" / "Pre-News" / "Live" / "Post-News"
//   NEWS_BLOCKED — true when setups must be suppressed
//   NEWS_POST    — true when in post-news bonus window
//   NEWS_EVENT   — name of the upcoming/current event
// ============================================================

// ── Time helpers (Pine v6 compatible) ────────────────────────
// Use timestamp() and time session strings to detect windows
// Pine v6: hour(), minute(), dayofweek() take no timezone arg —
// they return values in the chart's exchange timezone.
// We use time() with session strings in UTC instead — clean approach.

// ── Instrument detection (v2.7.1) ────────────────────────────
// Auto-detect instrument so crude oil events do NOT fire on
// Nifty, Gold, equities, etc.
// IS_CRUDE  : NYMEX CL futures and instruments with "CRUDE" in ticker
// IS_NATGAS : Natural Gas futures (NG, NATGAS)
// IS_EQUITY : Stocks / equity instruments via syminfo.type
// Everything else (Gold, indices, FX): manual override only.
bool IS_CRUDE  = str.contains(str.upper(syminfo.ticker), "CRUDE") or
                 str.contains(str.upper(syminfo.ticker), "CL1!") or
                 str.contains(str.upper(syminfo.ticker), "MCL")  or
                 (str.length(syminfo.ticker) <= 4 and
                  str.upper(syminfo.ticker) == "CL")
bool IS_NATGAS = str.contains(str.upper(syminfo.ticker), "NATGAS") or
                 str.contains(str.upper(syminfo.ticker), "NG1!")  or
                 (str.length(syminfo.ticker) <= 3 and
                  str.upper(syminfo.ticker) == "NG")
bool IS_EQUITY = syminfo.type == "stock"

// EIA Crude Inventory — Wednesday 14:30 UTC
bool _eia_pre  = IS_CRUDE and not na(time("1", "1415-1430:4", "UTC"))   // Wed 14:15–14:30 UTC
bool _eia_live = IS_CRUDE and not na(time("1", "1430-1435:4", "UTC"))   // Wed 14:30–14:35 UTC
bool _eia_post = IS_CRUDE and not na(time("1", "1435-1505:4", "UTC"))   // Wed 14:35–15:05 UTC

// API Crude Inventory — Tuesday 20:30 UTC
bool _api_pre  = IS_CRUDE and not na(time("1", "2015-2030:3", "UTC"))   // Tue 20:15–20:30 UTC
bool _api_live = IS_CRUDE and not na(time("1", "2030-2035:3", "UTC"))   // Tue 20:30–20:35 UTC
bool _api_post = IS_CRUDE and not na(time("1", "2035-2105:3", "UTC"))   // Tue 20:35–21:05 UTC

// EIA Natural Gas Inventory — Thursday 14:30 UTC
bool _ng_pre   = IS_NATGAS and not na(time("1", "1415-1430:5", "UTC"))  // Thu 14:15–14:30 UTC
bool _ng_live  = IS_NATGAS and not na(time("1", "1430-1435:5", "UTC"))  // Thu 14:30–14:35 UTC
bool _ng_post  = IS_NATGAS and not na(time("1", "1435-1505:5", "UTC"))  // Thu 14:35–15:05 UTC

// Equities and all other instruments (Gold, indices, FX):
// Auto events disabled — only IN_NEWS_MANUAL applies.

// ── Derive phase ─────────────────────────────────────────────
bool NEWS_BLOCKED = IN_NEWS_FILTER and (IN_NEWS_MANUAL or
     _eia_pre or _eia_live or _api_pre or _api_live or _ng_pre or _ng_live)
bool NEWS_POST    = IN_NEWS_FILTER and (_eia_post or _api_post or _ng_post)

string NEWS_EVENT = IN_NEWS_MANUAL ? "Manual Override" :
     _eia_pre  or _eia_live  or _eia_post  ? "EIA Crude"   :
     _api_pre  or _api_live  or _api_post  ? "API Crude"   :
     _ng_pre   or _ng_live   or _ng_post   ? "EIA Nat Gas" : "—"

string NEWS_PHASE = IN_NEWS_MANUAL ? "⚠ Manual Block" :
     _eia_pre  or _api_pre  or _ng_pre  ? "⚠ Pre-News"  :
     _eia_live or _api_live or _ng_live ? "⚠ Live"      :
     _eia_post or _api_post or _ng_post ? "★ Post-News" : "Clear"

// Note: NEWS_SWEEP_BULL/BEAR tracking is in Section 12.1 (after EVT_SSL/BSL_SWEPT declared)

// ── Pre-Positioning Engine (v3.1.0) ──────────────────────────
// Architecture:
//   During the PRE window, we observe structure bias and any early sweeps.
//   We record the expected post-news direction as NEWS_PREPOS_DIR.
//   When POST fires and a sweep confirms in that direction → premium flag.
//   This captures the "move before the move" — the institutional liquidity
//   grab that precedes the news-driven impulse.
//
// Outputs:
//   NEWS_PREPOS_DIR  — "Bull" / "Bear" / "" (direction bias recorded in PRE window)
//   NEWS_PREPOS_CONF — true on the first post-news bar where sweep confirms direction
// ─────────────────────────────────────────────────────────────

var string NEWS_PREPOS_DIR  = ""      // direction bias captured in pre-news window
var bool   NEWS_PREPOS_CONF = false   // confirmation event (fires once per news event)
var bool   NEWS_PREPOS_ARMED = false  // true once pre-window captures a direction
var bool   _prepos_post_seen = false  // tracks whether we've entered post window yet

bool _in_pre  = _eia_pre  or _api_pre  or _ng_pre
bool _in_live = _eia_live or _api_live or _ng_live
bool _in_post = _eia_post or _api_post or _ng_post

// Reset state when a new news cycle begins (pre window starts)
bool _pre_started = _in_pre and not _in_pre[1]
if _pre_started
    NEWS_PREPOS_DIR    := ""
    NEWS_PREPOS_ARMED  := false
    _prepos_post_seen  := false

// Capture direction bias during PRE window using HTF bias.
// HTF bias is available here (Section 6). STRUCTURE_BIAS is not yet declared
// at this point in execution order — it's confirmed downstream by the sweep.
// Priority: both HTF biases agree → strong; single HTF → moderate.
if IN_NEWS_PREPOS and _in_pre and not NEWS_PREPOS_ARMED
    if HTF_BIAS == HTF_BIAS_BULL
        NEWS_PREPOS_DIR   := "Bull"
        NEWS_PREPOS_ARMED := true
    else if HTF_BIAS == HTF_BIAS_BEAR
        NEWS_PREPOS_DIR   := "Bear"
        NEWS_PREPOS_ARMED := true

// Reset confirmation flag each bar
NEWS_PREPOS_CONF := false

// NOTE: Pre-positioning confirmation (EVT_SSL/BSL_SWEPT check) is in Section 12.1
// immediately after sweep events are set — EVT_SSL/BSL_SWEPT not yet declared here.

// Disarm if post window closes without confirmation (next pre will re-arm)
if not _in_pre and not _in_live and not _in_post and NEWS_PREPOS_ARMED and not _prepos_post_seen
    NEWS_PREPOS_ARMED := false
    NEWS_PREPOS_DIR   := ""

// ============================================================
// SECTION 12 — LIQUIDITY ENGINE
// ============================================================

var array<float>  bsl_price     = array.new<float>()
var array<int>    bsl_bar       = array.new<int>()
var array<bool>   bsl_swept     = array.new<bool>()
var array<int>    bsl_swept_bar = array.new<int>()
var array<string> bsl_type      = array.new<string>()
var array<line>   bsl_lines     = array.new<line>()
var array<label>  bsl_labels    = array.new<label>()
var array<float>  bsl_volume    = array.new<float>()

var array<float>  ssl_price     = array.new<float>()
var array<int>    ssl_bar       = array.new<int>()
var array<bool>   ssl_swept     = array.new<bool>()
var array<int>    ssl_swept_bar = array.new<int>()
var array<string> ssl_type      = array.new<string>()
var array<line>   ssl_lines     = array.new<line>()
var array<label>  ssl_labels    = array.new<label>()
var array<float>  ssl_volume    = array.new<float>()

var bool   EVT_BSL_SWEPT  = false
var bool   EVT_SSL_SWEPT  = false
var float  EVT_BSL_PRICE  = na
var float  EVT_SSL_PRICE  = na
var string LIQ_LAST_SWEEP = "—"

// Track bar of last sweep for post-sweep FVG tagging
var int LAST_BSL_SWEEP_BAR = 0
var int LAST_SSL_SWEEP_BAR = 0

// Sweep grade arrays — parallel to bsl/ssl, set at sweep time (v2.7.0)
var array<int> bsl_sweep_grade = array.new<int>()
var array<int> ssl_sweep_grade = array.new<int>()

// Last sweep grades for confluence scoring
var int  LAST_BSL_GRADE = SWEEP_C
var int  LAST_SSL_GRADE = SWEEP_C

// ── Running structure bias (pre-declared here so FVG filter in Section 13 can reference it)
var string STRUCTURE_BIAS = MS_BIAS_NONE

// ── Displacement pre-declarations ────────────────────────────
// Full engine is in Section 12.5, but sweep grading (below) needs
// EVT_DISP_BULL/BEAR. Compute early using same inputs/logic.
float _pre_disp_atr     = ta.atr(14)
float _pre_disp_vol_sma = ta.sma(volume, IN_VOL_LEN)
float _pre_disp_body    = math.abs(close[1] - open[1])
float _pre_disp_range   = high[1] - low[1]
bool  _pre_disp_ok      = _pre_disp_range > 0
     and (_pre_disp_body / _pre_disp_range)                              >= IN_DISP_BODY_MIN
     and (_pre_disp_atr     > 0 ? _pre_disp_range / _pre_disp_atr     : 0.0) >= IN_DISP_RANGE_MIN
     and (_pre_disp_vol_sma > 0 ? volume[1] / _pre_disp_vol_sma : 0.0) >= IN_DISP_VOL_MIN
bool EVT_DISP_BULL = _pre_disp_ok and close[1] >= open[1]
bool EVT_DISP_BEAR = _pre_disp_ok and close[1] <  open[1]

EVT_BSL_SWEPT := false
EVT_SSL_SWEPT := false

float swing_h   = ta.pivothigh(high, IN_SWING_LB, IN_SWING_LB)
float swing_l   = ta.pivotlow (low,  IN_SWING_LB, IN_SWING_LB)
int   pivot_bar = bar_index - IN_SWING_LB
float EQ_TOL   = IN_EQ_TOL * syminfo.mintick

// ── BSL Level Management ─────────────────────────────────────
if not na(swing_h) and IN_SHOW_BSL
    float px    = swing_h
    bool  is_eq = false
    int   n_bsl = array.size(bsl_price)

    if n_bsl > 0
        for i = 0 to n_bsl - 1
            if not array.get(bsl_swept, i)
                if math.abs(array.get(bsl_price, i) - px) <= EQ_TOL
                    array.set(bsl_type, i, LT_EQH)
                    line.set_color(array.get(bsl_lines, i), IN_EQ_BSL_COLOR)
                    line.set_width(array.get(bsl_lines, i), 2)
                    is_eq := true
                    break

    if not is_eq
        if array.size(bsl_price) >= 5
            line.delete(array.shift(bsl_lines))
            label.delete(array.shift(bsl_labels))
            array.shift(bsl_price)
            array.shift(bsl_bar)
            array.shift(bsl_swept)
            array.shift(bsl_swept_bar)
            array.shift(bsl_type)
            array.shift(bsl_volume)
            array.shift(bsl_sweep_grade)

        float pivot_vol = volume[IN_SWING_LB]

        line bsl_ln = line.new(pivot_bar, px, bar_index + 1, px,
             extend = extend.right, color = IN_BSL_COLOR, width = 1, style = line.style_solid)
        label bsl_lb = label.new(bar_index + 8, px,
             text = "",
             color = COLOR_NONE, textcolor = COLOR_NONE,
             style = label.style_label_down, size = size.small)

        array.push(bsl_price, px)
        array.push(bsl_bar, pivot_bar)
        array.push(bsl_swept, false)
        array.push(bsl_swept_bar, 0)
        array.push(bsl_type, LT_SH)
        array.push(bsl_lines, bsl_ln)
        array.push(bsl_labels, bsl_lb)
        array.push(bsl_volume, pivot_vol)
        array.push(bsl_sweep_grade, SWEEP_C)  // grade assigned at sweep time

// ── SSL Level Management ─────────────────────────────────────
if not na(swing_l) and IN_SHOW_SSL
    float px    = swing_l
    bool  is_eq = false
    int   n_ssl = array.size(ssl_price)

    if n_ssl > 0
        for i = 0 to n_ssl - 1
            if not array.get(ssl_swept, i)
                if math.abs(array.get(ssl_price, i) - px) <= EQ_TOL
                    array.set(ssl_type, i, LT_EQL)
                    line.set_color(array.get(ssl_lines, i), IN_EQ_SSL_COLOR)
                    line.set_width(array.get(ssl_lines, i), 2)
                    is_eq := true
                    break

    if not is_eq
        if array.size(ssl_price) >= 5
            line.delete(array.shift(ssl_lines))
            label.delete(array.shift(ssl_labels))
            array.shift(ssl_price)
            array.shift(ssl_bar)
            array.shift(ssl_swept)
            array.shift(ssl_swept_bar)
            array.shift(ssl_type)
            array.shift(ssl_volume)
            array.shift(ssl_sweep_grade)

        float pivot_vol = volume[IN_SWING_LB]

        line ssl_ln = line.new(pivot_bar, px, bar_index + 1, px,
             extend = extend.right, color = IN_SSL_COLOR, width = 1, style = line.style_solid)
        label ssl_lb = label.new(bar_index + 8, px,
             text = "",
             color = COLOR_NONE, textcolor = COLOR_NONE,
             style = label.style_label_up, size = size.small)

        array.push(ssl_price, px)
        array.push(ssl_bar, pivot_bar)
        array.push(ssl_swept, false)
        array.push(ssl_swept_bar, 0)
        array.push(ssl_type, LT_SL)
        array.push(ssl_lines, ssl_ln)
        array.push(ssl_labels, ssl_lb)
        array.push(ssl_volume, pivot_vol)
        array.push(ssl_sweep_grade, SWEEP_C)  // grade assigned at sweep time

// ── Sweep Detection ──────────────────────────────────────────
int n_bsl_sweep = array.size(bsl_price)
if n_bsl_sweep > 0
    for i = 0 to n_bsl_sweep - 1
        if not array.get(bsl_swept, i)
            float lvl = array.get(bsl_price, i)
            if high[1] > lvl and close[1] < lvl
                array.set(bsl_swept, i, true)
                array.set(bsl_swept_bar, i, bar_index - 1)
                line ln = array.get(bsl_lines, i)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, bar_index)
                line.set_color(ln, IN_SWEPT_COLOR)
                line.set_style(ln, line.style_dashed)
                line.set_width(ln, 1)
                label lb = array.get(bsl_labels, i)
                // ── Sweep Grading (v2.7.0) ───────────────────────────
                // Factor 1: wick rejection — close stays below level (bearish rejection)
                bool bsl_wick_ok    = close[1] < lvl
                // Factor 2: volume significance — level's volume vs average of all active levels
                float bsl_avg_vol   = 0.0
                int   bsl_vol_count = 0
                int   bsl_n_g       = array.size(bsl_volume)
                if bsl_n_g > 0
                    for gi = 0 to bsl_n_g - 1
                        bsl_avg_vol   += array.get(bsl_volume, gi)
                        bsl_vol_count += 1
                bsl_avg_vol := bsl_vol_count > 0 ? bsl_avg_vol / bsl_vol_count : 0.0
                bool bsl_vol_ok     = bsl_avg_vol > 0 and array.get(bsl_volume, i) >= bsl_avg_vol
                // Factor 3: displacement follow-through (bearish displacement on or after sweep bar)
                bool bsl_disp_ok    = EVT_DISP_BEAR
                int  bsl_factors    = (bsl_wick_ok ? 1 : 0) + (bsl_vol_ok ? 1 : 0) + (bsl_disp_ok ? 1 : 0)
                int  bsl_grade      = bsl_factors == 3 ? SWEEP_A : bsl_factors >= 2 ? SWEEP_B : SWEEP_C
                array.set(bsl_sweep_grade, i, bsl_grade)
                LAST_BSL_GRADE      := bsl_grade
                string bsl_grade_lbl = bsl_grade == SWEEP_A ? " [A]" : bsl_grade == SWEEP_B ? " [B]" : " [C]"
                label.set_text(lb, "")
                label.set_textcolor(lb, COLOR_NONE)
                EVT_BSL_SWEPT    := true
                EVT_BSL_PRICE    := lvl
                LIQ_LAST_SWEEP   := "BSL ✦ " + str.tostring(lvl, format.mintick) + bsl_grade_lbl
                LAST_BSL_SWEEP_BAR := bar_index

int n_ssl_sweep = array.size(ssl_price)
if n_ssl_sweep > 0
    for i = 0 to n_ssl_sweep - 1
        if not array.get(ssl_swept, i)
            float lvl = array.get(ssl_price, i)
            if low[1] < lvl and close[1] > lvl
                array.set(ssl_swept, i, true)
                array.set(ssl_swept_bar, i, bar_index - 1)
                line ln = array.get(ssl_lines, i)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, bar_index)
                line.set_color(ln, IN_SWEPT_COLOR)
                line.set_style(ln, line.style_dashed)
                line.set_width(ln, 1)
                label lb = array.get(ssl_labels, i)
                // ── Sweep Grading (v2.7.0) ───────────────────────────
                bool ssl_wick_ok    = close[1] > lvl
                float ssl_avg_vol   = 0.0
                int   ssl_vol_count = 0
                int   ssl_n_g       = array.size(ssl_volume)
                if ssl_n_g > 0
                    for gi = 0 to ssl_n_g - 1
                        ssl_avg_vol   += array.get(ssl_volume, gi)
                        ssl_vol_count += 1
                ssl_avg_vol := ssl_vol_count > 0 ? ssl_avg_vol / ssl_vol_count : 0.0
                bool ssl_vol_ok     = ssl_avg_vol > 0 and array.get(ssl_volume, i) >= ssl_avg_vol
                bool ssl_disp_ok    = EVT_DISP_BULL
                int  ssl_factors    = (ssl_wick_ok ? 1 : 0) + (ssl_vol_ok ? 1 : 0) + (ssl_disp_ok ? 1 : 0)
                int  ssl_grade      = ssl_factors == 3 ? SWEEP_A : ssl_factors >= 2 ? SWEEP_B : SWEEP_C
                array.set(ssl_sweep_grade, i, ssl_grade)
                LAST_SSL_GRADE      := ssl_grade
                string ssl_grade_lbl = ssl_grade == SWEEP_A ? " [A]" : ssl_grade == SWEEP_B ? " [B]" : " [C]"
                label.set_text(lb, "")
                label.set_textcolor(lb, COLOR_NONE)
                EVT_SSL_SWEPT    := true
                EVT_SSL_PRICE    := lvl
                LIQ_LAST_SWEEP   := "SSL ✦ " + str.tostring(lvl, format.mintick) + ssl_grade_lbl
                LAST_SSL_SWEEP_BAR := bar_index

// ── Swept Level Expiry ───────────────────────────────────────
int n_bsl_exp = array.size(bsl_price)
if n_bsl_exp > 0
    for i = n_bsl_exp - 1 to 0
        if array.get(bsl_swept, i)
            bool expire = not IN_SHOW_SWEPT or (bar_index - array.get(bsl_swept_bar, i) > IN_SWEPT_EXPIRY)
            if expire
                line.delete(array.remove(bsl_lines, i))
                label.delete(array.remove(bsl_labels, i))
                array.remove(bsl_price, i)
                array.remove(bsl_bar, i)
                array.remove(bsl_swept, i)
                array.remove(bsl_swept_bar, i)
                array.remove(bsl_type, i)
                array.remove(bsl_volume, i)
                array.remove(bsl_sweep_grade, i)

int n_ssl_exp = array.size(ssl_price)
if n_ssl_exp > 0
    for i = n_ssl_exp - 1 to 0
        if array.get(ssl_swept, i)
            bool expire = not IN_SHOW_SWEPT or (bar_index - array.get(ssl_swept_bar, i) > IN_SWEPT_EXPIRY)
            if expire
                line.delete(array.remove(ssl_lines, i))
                label.delete(array.remove(ssl_labels, i))
                array.remove(ssl_price, i)
                array.remove(ssl_bar, i)
                array.remove(ssl_swept, i)
                array.remove(ssl_swept_bar, i)
                array.remove(ssl_type, i)
                array.remove(ssl_volume, i)
                array.remove(ssl_sweep_grade, i)

// ── Label Position Update ────────────────────────────────────
// Labels are blank — just keep x position current for array integrity
if barstate.islast
    int n_bsl_lbl = array.size(bsl_labels)
    if n_bsl_lbl > 0
        for i = 0 to n_bsl_lbl - 1
            if not array.get(bsl_swept, i)
                label.set_x(array.get(bsl_labels, i), bar_index + 8)
    int n_ssl_lbl = array.size(ssl_labels)
    if n_ssl_lbl > 0
        for i = 0 to n_ssl_lbl - 1
            if not array.get(ssl_swept, i)
                label.set_x(array.get(ssl_labels, i), bar_index + 8)

// ── PDH/PDL Sweep Detection (v2.7.0) ─────────────────────────
// A sweep of a Previous Day High/Low is the highest quality liquidity event.
// Check if the swept level was within 2× ATR of PDH or PDL.
var bool PDH_SWEPT = false
var bool PDL_SWEPT = false
var int  PDH_SWEPT_BAR = 0
var int  PDL_SWEPT_BAR = 0

float _pdh_tol = ta.atr(14) * 2.0  // tolerance for "at PDH/PDL"

if EVT_BSL_SWEPT and not na(PD_HIGH)
    if math.abs(EVT_BSL_PRICE - PD_HIGH) <= _pdh_tol
        PDH_SWEPT     := true
        PDH_SWEPT_BAR := bar_index

if EVT_SSL_SWEPT and not na(PD_LOW)
    if math.abs(EVT_SSL_PRICE - PD_LOW) <= _pdh_tol
        PDL_SWEPT     := true
        PDL_SWEPT_BAR := bar_index

// Reset after 20 bars
if bar_index - PDH_SWEPT_BAR > 20
    PDH_SWEPT := false
if bar_index - PDL_SWEPT_BAR > 20
    PDL_SWEPT := false

// ── Pre-Positioning Confirmation (v3.1.0) ────────────────────
// Placed here (Section 12.1) because EVT_SSL/BSL_SWEPT must be set first.
// Checks if the post-news sweep confirms the direction captured in pre-window.
if IN_NEWS_PREPOS and NEWS_PREPOS_ARMED and _in_post and not _prepos_post_seen
    if NEWS_PREPOS_DIR == "Bull" and EVT_SSL_SWEPT
        NEWS_PREPOS_CONF  := true
        _prepos_post_seen := true
    else if NEWS_PREPOS_DIR == "Bear" and EVT_BSL_SWEPT
        NEWS_PREPOS_CONF  := true
        _prepos_post_seen := true

// ── Inducement Detection (v2.7.0) ────────────────────────────
// Inducement = a small liquidity grab that happens BEFORE the real sweep.
// Pattern: two sweeps on the same side within IN_CONF_LOOKBACK bars.
// The first sweep is the "inducement" — lures retail in the wrong direction.
// The second sweep is the real institutional move.
// If two sweeps happened within the lookback, the second one gets bonus scoring.

var int  INDU_BSL_COUNT = 0    // count of BSL sweeps in recent window
var int  INDU_SSL_COUNT = 0
var int  INDU_BSL_LAST  = 0    // bar of last BSL sweep
var int  INDU_SSL_LAST  = 0
var bool INDU_BSL_ACTIVE = false  // inducement pattern confirmed for BSL
var bool INDU_SSL_ACTIVE = false

if EVT_BSL_SWEPT
    if bar_index - INDU_BSL_LAST <= IN_CONF_LOOKBACK * 2
        INDU_BSL_COUNT += 1
    else
        INDU_BSL_COUNT := 1
    INDU_BSL_LAST  := bar_index
    INDU_BSL_ACTIVE := INDU_BSL_COUNT >= 2  // two sweeps = inducement confirmed

if EVT_SSL_SWEPT
    if bar_index - INDU_SSL_LAST <= IN_CONF_LOOKBACK * 2
        INDU_SSL_COUNT += 1
    else
        INDU_SSL_COUNT := 1
    INDU_SSL_LAST  := bar_index
    INDU_SSL_ACTIVE := INDU_SSL_COUNT >= 2

// Reset after 30 bars of no new sweeps
if bar_index - INDU_BSL_LAST > 30
    INDU_BSL_COUNT  := 0
    INDU_BSL_ACTIVE := false
if bar_index - INDU_SSL_LAST > 30
    INDU_SSL_COUNT  := 0
    INDU_SSL_ACTIVE := false

// ── News Sweep Tracking (v2.7.0) ─────────────────────────────
// Depends on EVT_SSL_SWEPT / EVT_BSL_SWEPT — must run after sweep detection
var bool NEWS_SWEEP_BULL = false
var bool NEWS_SWEEP_BEAR = false

if NEWS_BLOCKED or NEWS_POST
    if EVT_SSL_SWEPT
        NEWS_SWEEP_BULL := true
    if EVT_BSL_SWEPT
        NEWS_SWEEP_BEAR := true

// Reset once fully clear of post-news window
if not NEWS_BLOCKED and not NEWS_POST
    NEWS_SWEEP_BULL := false
    NEWS_SWEEP_BEAR := false

// ── Sweep Signal Markers ─────────────────────────────────────
plotshape(EVT_BSL_SWEPT, title = "BSL Swept",
     style = shape.triangledown, location = location.abovebar,
     color = IN_BSL_COLOR, size = size.tiny)
plotshape(EVT_SSL_SWEPT, title = "SSL Swept",
     style = shape.triangleup, location = location.belowbar,
     color = IN_SSL_COLOR, size = size.tiny)

// ============================================================
// SECTION 12.5 — DISPLACEMENT DETECTION ENGINE  (v2.7.0)
// ============================================================
// Architecture:
//   Measures per-bar move aggressiveness on the [1] confirmed bar.
//   Three independent metrics must all pass their thresholds:
//     1. Body %    — body / range >= IN_DISP_BODY_MIN
//     2. Range/ATR — (high-low) / ATR >= IN_DISP_RANGE_MIN
//     3. Volume    — volume / VolSMA >= IN_DISP_VOL_MIN
//
//   Grade logic:
//     All three >= threshold * 1.5  → DISP_STRONG
//     All three >= threshold        → DISP_NORMAL
//     Any one fails                 → DISP_NONE
//
//   Direction: candle color of bar[1] sets bull/bear direction.
//   Detection is on the confirmed bar[1] — zero repainting.
//
// Events published:
//   EVT_DISP_BULL  — true when a bullish displacement bar fires
//   EVT_DISP_BEAR  — true when a bearish displacement bar fires
//   DISP_GRADE     — int: DISP_NONE / DISP_NORMAL / DISP_STRONG
//   DISP_DIR       — string: "Bull" / "Bear" / "—"
//
// Consumers (downstream):
//   Section 13  — FVG quality model (displacement-backed FVGs)
//   Section 12  — Sweep grading (Step 4)
//   Section 14  — CHoCH+ simplified (Step 6)
//   Section 15  — Confluence scoring (Step 5)
// ============================================================

// ── 12.5.1 ATR + Volume SMA pre-computed here ────────────────
// ATR_VAL is declared above Section 6B — available here.
// VolSMA is already computed in Section 14 as CONF_VOL_SMA,
// but Section 14 runs after us — compute a local copy.
float DISP_ATR    = ta.atr(14)
float DISP_VOL_SMA = ta.sma(volume, IN_VOL_LEN)

// ── 12.5.2 Per-bar metric computation (bar[1]) ───────────────
float disp_body   = math.abs(close[1] - open[1])
float disp_range  = high[1] - low[1]
float disp_body_pct  = disp_range > 0 ? disp_body / disp_range : 0.0
float disp_range_atr = DISP_ATR    > 0 ? disp_range / DISP_ATR    : 0.0
float disp_vol_ratio = DISP_VOL_SMA > 0 ? volume[1] / DISP_VOL_SMA : 0.0

// ── 12.5.3 Threshold checks ──────────────────────────────────
bool disp_body_ok  = disp_body_pct  >= IN_DISP_BODY_MIN
bool disp_range_ok = disp_range_atr >= IN_DISP_RANGE_MIN
bool disp_vol_ok   = disp_vol_ratio >= IN_DISP_VOL_MIN
bool disp_all_ok   = disp_body_ok and disp_range_ok and disp_vol_ok

// Strong: all three exceed 1.5× their thresholds
bool disp_body_strong  = disp_body_pct  >= IN_DISP_BODY_MIN  * 1.5
bool disp_range_strong = disp_range_atr >= IN_DISP_RANGE_MIN * 1.5
bool disp_vol_strong   = disp_vol_ratio >= IN_DISP_VOL_MIN   * 1.5
bool disp_all_strong   = disp_body_strong and disp_range_strong and disp_vol_strong

// ── 12.5.4 Grade + Direction ─────────────────────────────────
int DISP_GRADE = disp_all_ok ? (disp_all_strong ? DISP_STRONG : DISP_NORMAL) : DISP_NONE

string DISP_DIR = DISP_GRADE == DISP_NONE ? "—" : close[1] >= open[1] ? "Bull" : "Bear"

// EVT_DISP_BULL / EVT_DISP_BEAR declared earlier in Section 12
// (before sweep detection) so sweep grading can reference them.
// They are consistent with DISP_GRADE — no redeclaration needed.

// ============================================================
// SECTION 13 — FVG ENGINE
// ============================================================
// Architecture:
//   Bullish FVG: high[3] < low[1]  →  gap zone = [high[3], low[1]]
//   Bearish FVG: low[3]  > high[1] →  gap zone = [high[1], low[3]]
//
//   Detection uses [1],[2],[3] — the 3-candle pattern is fully
//   confirmed by bar[1]'s close. We detect on the NEXT bar.
//   This guarantees zero repainting.
//
//   CE (Consequent Encroachment) = midpoint of the FVG.
//   Mitigation: price crosses CE → Tested.
//               price fills entire FVG → Mitigated.
//
//   Post-sweep tag: if a sweep happened within IN_FVG_SWEEP_WIN
//   bars before FVG formation → highest quality signal.
//
// Events published:
//   EVT_FVG_BULL       — true on the bar a bullish FVG is detected
//   EVT_FVG_BEAR       — true on the bar a bearish FVG is detected
//   EVT_FVG_BULL_TEST  — true when price enters a bull FVG zone
//   EVT_FVG_BEAR_TEST  — true when price enters a bear FVG zone
// ============================================================

// ── 13.1 ATR — declared above Section 6B, referenced here ───

// ── 13.2 State Arrays — Bullish FVG ─────────────────────────
var array<float>  fvg_bull_top       = array.new<float>()   // low[1] — top of gap
var array<float>  fvg_bull_bot       = array.new<float>()   // high[3] — bottom of gap
var array<float>  fvg_bull_ce        = array.new<float>()   // midpoint
var array<int>    fvg_bull_bar       = array.new<int>()     // bar where FVG formed
var array<string> fvg_bull_state     = array.new<string>()  // Fresh/Tested/Mitigated
var array<string> fvg_bull_grade     = array.new<string>()  // S/M/L
var array<int>    fvg_bull_mit_bar   = array.new<int>()     // bar where mitigated
var array<bool>   fvg_bull_post_sweep = array.new<bool>()   // formed after a sweep?
var array<box>    fvg_bull_boxes     = array.new<box>()
var array<line>   fvg_bull_ce_lines  = array.new<line>()
var array<label>  fvg_bull_labels    = array.new<label>()

// ── 13.3 State Arrays — Bearish FVG ─────────────────────────
var array<float>  fvg_bear_top       = array.new<float>()   // low[3] — top of gap
var array<float>  fvg_bear_bot       = array.new<float>()   // high[1] — bottom of gap
var array<float>  fvg_bear_ce        = array.new<float>()
var array<int>    fvg_bear_bar       = array.new<int>()
var array<string> fvg_bear_state     = array.new<string>()
var array<string> fvg_bear_grade     = array.new<string>()
var array<int>    fvg_bear_mit_bar   = array.new<int>()
var array<bool>   fvg_bear_post_sweep = array.new<bool>()
var array<box>    fvg_bear_boxes     = array.new<box>()
var array<line>   fvg_bear_ce_lines  = array.new<line>()
var array<label>  fvg_bear_labels    = array.new<label>()

// ── 13.4 FVG Event Variables ─────────────────────────────────
var bool EVT_FVG_BULL      = false
var bool EVT_FVG_BEAR      = false
var bool EVT_FVG_BULL_TEST = false
var bool EVT_FVG_BEAR_TEST = false

EVT_FVG_BULL      := false
EVT_FVG_BEAR      := false
EVT_FVG_BULL_TEST := false
EVT_FVG_BEAR_TEST := false

// ── 13.5 Session Gap Filter ──────────────────────────────────
// Bars [3],[2],[1] must be from the same session — overnight gaps are not FVGs
int _tf_ms = timeframe.in_seconds() * 1000
bool fvg_no_session_gap = (time[1] - time[3]) <= _tf_ms * 6

// ── 13.6 Bullish FVG Detection ───────────────────────────────
// Pattern: bar[3].high < bar[1].low → upward gap
// Impulse: candle[2] must be bullish with body ≥ IN_FVG_BODY_PCT
// Consecutive: at least 2 of the 3 candles [3],[2],[1] must be bullish
float  c2_bull_body  = math.abs(close[2] - open[2])
float  c2_bull_range = high[2] - low[2]
bool   c2_bull_ok    = close[2] > open[2] and c2_bull_range > 0 and (c2_bull_body / c2_bull_range) >= IN_FVG_BODY_PCT
// Consecutive candle check — at least 2 of 3 must be bullish
int    bull_candle_count = (close[1] > open[1] ? 1 : 0) + (close[2] > open[2] ? 1 : 0) + (close[3] > open[3] ? 1 : 0)
bool   fvg_bull_consecutive = bull_candle_count >= 2
bool   fvg_bull_detected = high[3] < low[1] and c2_bull_ok and fvg_no_session_gap and fvg_bull_consecutive
float  fvg_bull_top_px   = low[1]
float  fvg_bull_bot_px   = high[3]
float  fvg_bull_width    = fvg_bull_top_px - fvg_bull_bot_px
float  fvg_bull_ce_px    = (fvg_bull_top_px + fvg_bull_bot_px) / 2.0
string fvg_bull_gr       = fvg_bull_width >= ATR_VAL ? FVG_GRADE_L :
                           fvg_bull_width >= ATR_VAL * 0.5 ? FVG_GRADE_M :
                           FVG_GRADE_S

// Check if this is a post-sweep FVG (SSL sweep happened recently → bullish FVG)
bool fvg_bull_is_post_sweep = (bar_index - LAST_SSL_SWEEP_BAR) <= IN_FVG_SWEEP_WIN

if fvg_bull_detected and IN_SHOW_FVG and IN_SHOW_FVG_BULL and fvg_bull_width >= ATR_VAL * IN_FVG_MIN_ATR
     and (STRUCTURE_BIAS == MS_BIAS_BULL or STRUCTURE_BIAS == MS_BIAS_NONE)
    // Capacity check — FIFO
    if array.size(fvg_bull_top) >= 5
        box.delete(array.shift(fvg_bull_boxes))
        line.delete(array.shift(fvg_bull_ce_lines))
        label.delete(array.shift(fvg_bull_labels))
        array.shift(fvg_bull_top)
        array.shift(fvg_bull_bot)
        array.shift(fvg_bull_ce)
        array.shift(fvg_bull_bar)
        array.shift(fvg_bull_state)
        array.shift(fvg_bull_grade)
        array.shift(fvg_bull_mit_bar)
        array.shift(fvg_bull_post_sweep)

    // Transparency based on grade
    int transp = fn_fvg_transp(fvg_bull_gr)
    color box_color = color.new(IN_FVG_BULL_COLOR, transp)

    // Draw FVG box — starts at bar[2], right edge updated on barstate.islast
    box fvg_bx = box.new(
         left     = bar_index - 2,
         top      = fvg_bull_top_px,
         right    = bar_index + 10,
         bottom   = fvg_bull_bot_px,
         bgcolor  = box_color,
         border_color = color.new(IN_FVG_BULL_COLOR, transp - 10),
         border_width = 1)

    // CE line — dotted at midpoint
    line fvg_ce_ln = line.new(
         x1 = bar_index - 2, y1 = fvg_bull_ce_px,
         x2 = bar_index + 10, y2 = fvg_bull_ce_px,
         color  = IN_SHOW_CE ? color.new(IN_FVG_BULL_COLOR, transp - 20) : COLOR_NONE,
         width  = 1,
         style  = line.style_dotted)

    // Label — below the box
    string lbl_prefix = fvg_bull_is_post_sweep ? "★ " : ""
    string fvg_dbg = IN_SHOW_DEBUG ? "\nT:" + str.tostring(fvg_bull_top_px, format.mintick) + " B:" + str.tostring(fvg_bull_bot_px, format.mintick) + "\nh[3]=" + str.tostring(high[3], format.mintick) + " l[1]=" + str.tostring(low[1], format.mintick) : ""
    label fvg_lb = label.new(
         x         = bar_index + 8,
         y         = fvg_bull_bot_px,
         text      = lbl_prefix + "FVG " + fvg_bull_gr + fvg_dbg,
         color     = COLOR_NONE,
         textcolor = IN_FVG_BULL_COLOR,
         style     = label.style_label_up,
         size      = size.small)

    array.push(fvg_bull_top,        fvg_bull_top_px)
    array.push(fvg_bull_bot,        fvg_bull_bot_px)
    array.push(fvg_bull_ce,         fvg_bull_ce_px)
    array.push(fvg_bull_bar,        bar_index)
    array.push(fvg_bull_state,      FVG_FRESH)
    array.push(fvg_bull_grade,      fvg_bull_gr)
    array.push(fvg_bull_mit_bar,    0)
    array.push(fvg_bull_post_sweep, fvg_bull_is_post_sweep)
    array.push(fvg_bull_boxes,      fvg_bx)
    array.push(fvg_bull_ce_lines,   fvg_ce_ln)
    array.push(fvg_bull_labels,     fvg_lb)

    EVT_FVG_BULL := true

// ── 13.6 Bearish FVG Detection ───────────────────────────────
// Pattern: low[3] > high[1] → downward gap
// Impulse: candle[2] must be bearish with body ≥ IN_FVG_BODY_PCT
// Consecutive: at least 2 of the 3 candles [3],[2],[1] must be bearish
float  c2_bear_body  = math.abs(close[2] - open[2])
float  c2_bear_range = high[2] - low[2]
bool   c2_bear_ok    = close[2] < open[2] and c2_bear_range > 0 and (c2_bear_body / c2_bear_range) >= IN_FVG_BODY_PCT
// Consecutive candle check — at least 2 of 3 must be bearish
int    bear_candle_count = (close[1] < open[1] ? 1 : 0) + (close[2] < open[2] ? 1 : 0) + (close[3] < open[3] ? 1 : 0)
bool   fvg_bear_consecutive = bear_candle_count >= 2
bool   fvg_bear_detected = low[3] > high[1] and c2_bear_ok and fvg_no_session_gap and fvg_bear_consecutive
float  fvg_bear_top_px   = low[3]
float  fvg_bear_bot_px   = high[1]
float  fvg_bear_width    = fvg_bear_top_px - fvg_bear_bot_px
float  fvg_bear_ce_px    = (fvg_bear_top_px + fvg_bear_bot_px) / 2.0
string fvg_bear_gr       = fvg_bear_width >= ATR_VAL ? FVG_GRADE_L :
                           fvg_bear_width >= ATR_VAL * 0.5 ? FVG_GRADE_M :
                           FVG_GRADE_S

// Post-sweep: BSL sweep happened recently → bearish FVG
bool fvg_bear_is_post_sweep = (bar_index - LAST_BSL_SWEEP_BAR) <= IN_FVG_SWEEP_WIN

if fvg_bear_detected and IN_SHOW_FVG and IN_SHOW_FVG_BEAR and fvg_bear_width >= ATR_VAL * IN_FVG_MIN_ATR
     and (STRUCTURE_BIAS == MS_BIAS_BEAR or STRUCTURE_BIAS == MS_BIAS_NONE)
    if array.size(fvg_bear_top) >= 5
        box.delete(array.shift(fvg_bear_boxes))
        line.delete(array.shift(fvg_bear_ce_lines))
        label.delete(array.shift(fvg_bear_labels))
        array.shift(fvg_bear_top)
        array.shift(fvg_bear_bot)
        array.shift(fvg_bear_ce)
        array.shift(fvg_bear_bar)
        array.shift(fvg_bear_state)
        array.shift(fvg_bear_grade)
        array.shift(fvg_bear_mit_bar)
        array.shift(fvg_bear_post_sweep)

    int transp = fn_fvg_transp(fvg_bear_gr)
    color box_color = color.new(IN_FVG_BEAR_COLOR, transp)

    box fvg_bx = box.new(
         left     = bar_index - 2,
         top      = fvg_bear_top_px,
         right    = bar_index + 10,
         bottom   = fvg_bear_bot_px,
         bgcolor  = box_color,
         border_color = color.new(IN_FVG_BEAR_COLOR, transp - 10),
         border_width = 1)

    line fvg_ce_ln = line.new(
         x1 = bar_index - 2, y1 = fvg_bear_ce_px,
         x2 = bar_index + 10, y2 = fvg_bear_ce_px,
         color  = IN_SHOW_CE ? color.new(IN_FVG_BEAR_COLOR, transp - 20) : COLOR_NONE,
         width  = 1,
         style  = line.style_dotted)

    string lbl_prefix = fvg_bear_is_post_sweep ? "★ " : ""
    string fvg_dbg2 = IN_SHOW_DEBUG ? "\nT:" + str.tostring(fvg_bear_top_px, format.mintick) + " B:" + str.tostring(fvg_bear_bot_px, format.mintick) + "\nl[3]=" + str.tostring(low[3], format.mintick) + " h[1]=" + str.tostring(high[1], format.mintick) : ""
    label fvg_lb = label.new(
         x         = bar_index + 8,
         y         = fvg_bear_top_px,
         text      = lbl_prefix + "FVG " + fvg_bear_gr + fvg_dbg2,
         color     = COLOR_NONE,
         textcolor = IN_FVG_BEAR_COLOR,
         style     = label.style_label_down,
         size      = size.small)

    array.push(fvg_bear_top,        fvg_bear_top_px)
    array.push(fvg_bear_bot,        fvg_bear_bot_px)
    array.push(fvg_bear_ce,         fvg_bear_ce_px)
    array.push(fvg_bear_bar,        bar_index)
    array.push(fvg_bear_state,      FVG_FRESH)
    array.push(fvg_bear_grade,      fvg_bear_gr)
    array.push(fvg_bear_mit_bar,    0)
    array.push(fvg_bear_post_sweep, fvg_bear_is_post_sweep)
    array.push(fvg_bear_boxes,      fvg_bx)
    array.push(fvg_bear_ce_lines,   fvg_ce_ln)
    array.push(fvg_bear_labels,     fvg_lb)

    EVT_FVG_BEAR := true

// ── 13.7 FVG Quality Model State Transitions (v2.7.0) ────────
// 5-state model: Fresh → First Touch → CE Touch → Deep Retest → Mitigated
// States advance forward only. Checked on confirmed bar[1].
//
// Bullish FVG (zone: _bot to _top, CE at midpoint):
//   FRESH → FIRST_TOUCH : low[1] enters zone from above but stays above CE
//   * → CE_TOUCH        : low[1] <= CE (close[1] still above _bot)
//   CE_TOUCH → DEEP_RETEST : close[1] <= CE but close[1] > _bot
//   Any active → MITIGATED : close[1] <= _bot (closed through zone)

// Event variables for state transitions
var bool EVT_FVG_BULL_FIRST_TOUCH = false
var bool EVT_FVG_BULL_CE_TOUCH    = false
var bool EVT_FVG_BULL_DEEP_RETEST = false
var bool EVT_FVG_BEAR_FIRST_TOUCH = false
var bool EVT_FVG_BEAR_CE_TOUCH    = false
var bool EVT_FVG_BEAR_DEEP_RETEST = false

EVT_FVG_BULL_FIRST_TOUCH := false
EVT_FVG_BULL_CE_TOUCH    := false
EVT_FVG_BULL_DEEP_RETEST := false
EVT_FVG_BEAR_FIRST_TOUCH := false
EVT_FVG_BEAR_CE_TOUCH    := false
EVT_FVG_BEAR_DEEP_RETEST := false

// ── Bullish FVG transitions ───────────────────────────────────
int n_fvg_bull_mit = array.size(fvg_bull_top)
if n_fvg_bull_mit > 0
    for i = 0 to n_fvg_bull_mit - 1
        string st  = array.get(fvg_bull_state, i)
        float  ce  = array.get(fvg_bull_ce, i)
        float  bot = array.get(fvg_bull_bot, i)
        float  top = array.get(fvg_bull_top, i)

        if st != FVG_MITIGATED
            // Mitigated: close[1] closes through the bottom of the zone
            if close[1] <= bot
                array.set(fvg_bull_state, i, FVG_MITIGATED)
                array.set(fvg_bull_mit_bar, i, bar_index)
                box.set_bgcolor(array.get(fvg_bull_boxes, i), IN_FVG_MIT_COLOR)
                box.set_border_color(array.get(fvg_bull_boxes, i), color.new(#636366, 80))
                box.set_right(array.get(fvg_bull_boxes, i), bar_index)
                line.set_x2(array.get(fvg_bull_ce_lines, i), bar_index)
                line.set_color(array.get(fvg_bull_ce_lines, i), IN_FVG_MIT_COLOR)
                label.set_textcolor(array.get(fvg_bull_labels, i), color.new(#636366, 50))

            // Deep Retest: CE Touch state — close[1] dips past CE but doesn't close through bottom
            else if st == FVG_CE_TOUCH and close[1] <= ce
                array.set(fvg_bull_state, i, FVG_DEEP_RETEST)
                box.set_bgcolor(array.get(fvg_bull_boxes, i), color.new(IN_FVG_BULL_COLOR, 93))
                box.set_border_color(array.get(fvg_bull_boxes, i), color.new(#8E8E93, 60))
                EVT_FVG_BULL_DEEP_RETEST := true
                EVT_FVG_BULL_TEST        := true

            // CE Touch: low[1] reaches or passes CE
            else if (st == FVG_FRESH or st == FVG_FIRST_TOUCH) and low[1] <= ce
                array.set(fvg_bull_state, i, FVG_CE_TOUCH)
                box.set_border_color(array.get(fvg_bull_boxes, i), IN_FVG_TEST_COLOR)
                EVT_FVG_BULL_CE_TOUCH := true
                EVT_FVG_BULL_TEST     := true

            // First Touch: low[1] enters zone from above but hasn't reached CE
            else if st == FVG_FRESH and low[1] <= top and low[1] > ce
                array.set(fvg_bull_state, i, FVG_FIRST_TOUCH)
                box.set_border_color(array.get(fvg_bull_boxes, i), color.new(IN_FVG_BULL_COLOR, 40))
                EVT_FVG_BULL_FIRST_TOUCH := true

// ── Bearish FVG transitions ───────────────────────────────────
int n_fvg_bear_mit = array.size(fvg_bear_top)
if n_fvg_bear_mit > 0
    for i = 0 to n_fvg_bear_mit - 1
        string st  = array.get(fvg_bear_state, i)
        float  ce  = array.get(fvg_bear_ce, i)
        float  bot = array.get(fvg_bear_bot, i)
        float  top = array.get(fvg_bear_top, i)

        if st != FVG_MITIGATED
            // Mitigated: close[1] closes through the top of the zone
            if close[1] >= top
                array.set(fvg_bear_state, i, FVG_MITIGATED)
                array.set(fvg_bear_mit_bar, i, bar_index)
                box.set_bgcolor(array.get(fvg_bear_boxes, i), IN_FVG_MIT_COLOR)
                box.set_border_color(array.get(fvg_bear_boxes, i), color.new(#636366, 80))
                box.set_right(array.get(fvg_bear_boxes, i), bar_index)
                line.set_x2(array.get(fvg_bear_ce_lines, i), bar_index)
                line.set_color(array.get(fvg_bear_ce_lines, i), IN_FVG_MIT_COLOR)
                label.set_textcolor(array.get(fvg_bear_labels, i), color.new(#636366, 50))

            // Deep Retest: close[1] pushes past CE but doesn't close through top
            else if st == FVG_CE_TOUCH and close[1] >= ce
                array.set(fvg_bear_state, i, FVG_DEEP_RETEST)
                box.set_bgcolor(array.get(fvg_bear_boxes, i), color.new(IN_FVG_BEAR_COLOR, 93))
                box.set_border_color(array.get(fvg_bear_boxes, i), color.new(#8E8E93, 60))
                EVT_FVG_BEAR_DEEP_RETEST := true
                EVT_FVG_BEAR_TEST        := true

            // CE Touch: high[1] reaches or passes CE
            else if (st == FVG_FRESH or st == FVG_FIRST_TOUCH) and high[1] >= ce
                array.set(fvg_bear_state, i, FVG_CE_TOUCH)
                box.set_border_color(array.get(fvg_bear_boxes, i), IN_FVG_TEST_COLOR)
                EVT_FVG_BEAR_CE_TOUCH := true
                EVT_FVG_BEAR_TEST     := true

            // First Touch: high[1] enters zone from below but hasn't reached CE
            else if st == FVG_FRESH and high[1] >= bot and high[1] < ce
                array.set(fvg_bear_state, i, FVG_FIRST_TOUCH)
                box.set_border_color(array.get(fvg_bear_boxes, i), color.new(IN_FVG_BEAR_COLOR, 40))
                EVT_FVG_BEAR_FIRST_TOUCH := true

// ── 13.8 FVG Expiry ──────────────────────────────────────────
// Fresh/Tested: expire after IN_FVG_MAX_AGE bars
// Mitigated: expire after IN_FVG_MIT_EXPIRY bars (or immediately if hidden)

int n_fvg_bull_exp = array.size(fvg_bull_top)
if n_fvg_bull_exp > 0
    for i = n_fvg_bull_exp - 1 to 0
        string st = array.get(fvg_bull_state, i)
        bool expire = false
        if st == FVG_MITIGATED
            expire := not IN_SHOW_FVG_MIT or (bar_index - array.get(fvg_bull_mit_bar, i) > IN_FVG_MIT_EXPIRY)
        else
            expire := (bar_index - array.get(fvg_bull_bar, i) > IN_FVG_MAX_AGE)
        if expire
            box.delete(array.remove(fvg_bull_boxes, i))
            line.delete(array.remove(fvg_bull_ce_lines, i))
            label.delete(array.remove(fvg_bull_labels, i))
            array.remove(fvg_bull_top, i)
            array.remove(fvg_bull_bot, i)
            array.remove(fvg_bull_ce, i)
            array.remove(fvg_bull_bar, i)
            array.remove(fvg_bull_state, i)
            array.remove(fvg_bull_grade, i)
            array.remove(fvg_bull_mit_bar, i)
            array.remove(fvg_bull_post_sweep, i)

int n_fvg_bear_exp = array.size(fvg_bear_top)
if n_fvg_bear_exp > 0
    for i = n_fvg_bear_exp - 1 to 0
        string st = array.get(fvg_bear_state, i)
        bool expire = false
        if st == FVG_MITIGATED
            expire := not IN_SHOW_FVG_MIT or (bar_index - array.get(fvg_bear_mit_bar, i) > IN_FVG_MIT_EXPIRY)
        else
            expire := (bar_index - array.get(fvg_bear_bar, i) > IN_FVG_MAX_AGE)
        if expire
            box.delete(array.remove(fvg_bear_boxes, i))
            line.delete(array.remove(fvg_bear_ce_lines, i))
            label.delete(array.remove(fvg_bear_labels, i))
            array.remove(fvg_bear_top, i)
            array.remove(fvg_bear_bot, i)
            array.remove(fvg_bear_ce, i)
            array.remove(fvg_bear_bar, i)
            array.remove(fvg_bear_state, i)
            array.remove(fvg_bear_grade, i)
            array.remove(fvg_bear_mit_bar, i)
            array.remove(fvg_bear_post_sweep, i)

// ── 13.9 FVG Position Update (labels + box right edge) ───────
if barstate.islast
    int n_fb_lbl = array.size(fvg_bull_labels)
    if n_fb_lbl > 0
        for i = 0 to n_fb_lbl - 1
            if array.get(fvg_bull_state, i) != FVG_MITIGATED
                label.set_x(array.get(fvg_bull_labels, i), bar_index + 8)
                box.set_right(array.get(fvg_bull_boxes, i), bar_index + 3)
                line.set_x2(array.get(fvg_bull_ce_lines, i), bar_index + 3)
    int n_fbe_lbl = array.size(fvg_bear_labels)
    if n_fbe_lbl > 0
        for i = 0 to n_fbe_lbl - 1
            if array.get(fvg_bear_state, i) != FVG_MITIGATED
                label.set_x(array.get(fvg_bear_labels, i), bar_index + 8)
                box.set_right(array.get(fvg_bear_boxes, i), bar_index + 3)
                line.set_x2(array.get(fvg_bear_ce_lines, i), bar_index + 3)

// ============================================================
// SECTION 13B — ORDER BLOCK ENGINE
// ============================================================
// Architecture:
//   An Order Block is the last opposing candle before a displacement.
//   Bullish OB = last bearish candle before a bullish FVG forms.
//   Bearish OB = last bullish candle before a bearish FVG forms.
//   The OB zone is the candle's body (or full range if configured).
//   When price returns to the OB, it's expected to hold (institutional defense).
//
//   Detection: triggered by FVG creation events (EVT_FVG_BULL / EVT_FVG_BEAR).
//   States: Fresh → Tested (price enters zone) → Mitigated (price closes through).
// ============================================================

// ── 13B.1 Order Block Arrays ────────────────────────────────
var array<float>  ob_bull_top     = array.new<float>()
var array<float>  ob_bull_bot     = array.new<float>()
var array<int>    ob_bull_bar     = array.new<int>()
var array<string> ob_bull_state   = array.new<string>()
var array<int>    ob_bull_mit_bar = array.new<int>()
var array<box>    ob_bull_boxes   = array.new<box>()
var array<label>  ob_bull_labels  = array.new<label>()

var array<float>  ob_bear_top     = array.new<float>()
var array<float>  ob_bear_bot     = array.new<float>()
var array<int>    ob_bear_bar     = array.new<int>()
var array<string> ob_bear_state   = array.new<string>()
var array<int>    ob_bear_mit_bar = array.new<int>()
var array<box>    ob_bear_boxes   = array.new<box>()
var array<label>  ob_bear_labels  = array.new<label>()

// ── 13B.2 Bullish Order Block Detection ─────────────────────
// Triggered when a bullish FVG forms — search backwards for the last bearish candle
if EVT_FVG_BULL and IN_SHOW_OB
    int ob_idx = -1
    for lb = 3 to 3 + IN_OB_LOOKBACK
        if close[lb] < open[lb]
            ob_idx := lb
            break

    if ob_idx >= 0
        float _top = IN_OB_BODY_ONLY ? open[ob_idx] : high[ob_idx]
        float _bot = IN_OB_BODY_ONLY ? close[ob_idx] : low[ob_idx]
        int   _bar = bar_index - ob_idx

        // Capacity — max 3 OBs per side
        if array.size(ob_bull_top) >= 3
            box.delete(array.shift(ob_bull_boxes))
            label.delete(array.shift(ob_bull_labels))
            array.shift(ob_bull_top)
            array.shift(ob_bull_bot)
            array.shift(ob_bull_bar)
            array.shift(ob_bull_state)
            array.shift(ob_bull_mit_bar)

        box ob_bx = box.new(
             left = _bar, top = _top,
             right = bar_index + 10, bottom = _bot,
             bgcolor = COLOR_NONE,
             border_color = color.new(#00C087, 20),
             border_width = 2)

        label ob_lb = label.new(
             x = bar_index + 8, y = _bot,
             text = "OB",
             color = COLOR_NONE, textcolor = color.new(#00C087, 20),
             style = label.style_label_up, size = size.tiny)

        array.push(ob_bull_top,     _top)
        array.push(ob_bull_bot,     _bot)
        array.push(ob_bull_bar,     _bar)
        array.push(ob_bull_state,   FVG_FRESH)
        array.push(ob_bull_mit_bar, 0)
        array.push(ob_bull_boxes,   ob_bx)
        array.push(ob_bull_labels,  ob_lb)

// ── 13B.3 Bearish Order Block Detection ─────────────────────
if EVT_FVG_BEAR and IN_SHOW_OB
    int ob_idx = -1
    for lb = 3 to 3 + IN_OB_LOOKBACK
        if close[lb] > open[lb]
            ob_idx := lb
            break

    if ob_idx >= 0
        float _top = IN_OB_BODY_ONLY ? close[ob_idx] : high[ob_idx]
        float _bot = IN_OB_BODY_ONLY ? open[ob_idx] : low[ob_idx]
        int   _bar = bar_index - ob_idx

        if array.size(ob_bear_top) >= 3
            box.delete(array.shift(ob_bear_boxes))
            label.delete(array.shift(ob_bear_labels))
            array.shift(ob_bear_top)
            array.shift(ob_bear_bot)
            array.shift(ob_bear_bar)
            array.shift(ob_bear_state)
            array.shift(ob_bear_mit_bar)

        box ob_bx = box.new(
             left = _bar, top = _top,
             right = bar_index + 10, bottom = _bot,
             bgcolor = COLOR_NONE,
             border_color = color.new(#FF3B30, 20),
             border_width = 2)

        label ob_lb = label.new(
             x = bar_index + 8, y = _top,
             text = "OB",
             color = COLOR_NONE, textcolor = color.new(#FF3B30, 20),
             style = label.style_label_down, size = size.tiny)

        array.push(ob_bear_top,     _top)
        array.push(ob_bear_bot,     _bot)
        array.push(ob_bear_bar,     _bar)
        array.push(ob_bear_state,   FVG_FRESH)
        array.push(ob_bear_mit_bar, 0)
        array.push(ob_bear_boxes,   ob_bx)
        array.push(ob_bear_labels,  ob_lb)

// ── 13B.4 Order Block Mitigation ────────────────────────────
// Bullish OB: price drops into zone → tested at midpoint, mitigated if close[1] < bottom
int n_ob_bull_mit = array.size(ob_bull_top)
if n_ob_bull_mit > 0
    for i = 0 to n_ob_bull_mit - 1
        string st = array.get(ob_bull_state, i)
        if st == FVG_FRESH
            float _top = array.get(ob_bull_top, i)
            float _bot = array.get(ob_bull_bot, i)
            float _ce  = (_top + _bot) / 2.0
            if low[1] <= _ce and low[1] >= _bot
                array.set(ob_bull_state, i, FVG_TESTED)
                box.set_border_color(array.get(ob_bull_boxes, i), color.new(#FFD60A, 40))
            else if close[1] < _bot
                array.set(ob_bull_state, i, FVG_MITIGATED)
                array.set(ob_bull_mit_bar, i, bar_index)
                box.set_bgcolor(array.get(ob_bull_boxes, i), IN_OB_MIT_COLOR)
                box.set_border_color(array.get(ob_bull_boxes, i), color.new(#636366, 80))
                box.set_right(array.get(ob_bull_boxes, i), bar_index)
                label.set_textcolor(array.get(ob_bull_labels, i), color.new(#636366, 50))
        else if st == FVG_TESTED
            float _bot = array.get(ob_bull_bot, i)
            if close[1] < _bot
                array.set(ob_bull_state, i, FVG_MITIGATED)
                array.set(ob_bull_mit_bar, i, bar_index)
                box.set_bgcolor(array.get(ob_bull_boxes, i), IN_OB_MIT_COLOR)
                box.set_border_color(array.get(ob_bull_boxes, i), color.new(#636366, 80))
                box.set_right(array.get(ob_bull_boxes, i), bar_index)
                label.set_textcolor(array.get(ob_bull_labels, i), color.new(#636366, 50))

// Bearish OB: price pushes into zone → tested at midpoint, mitigated if close[1] > top
int n_ob_bear_mit = array.size(ob_bear_top)
if n_ob_bear_mit > 0
    for i = 0 to n_ob_bear_mit - 1
        string st = array.get(ob_bear_state, i)
        if st == FVG_FRESH
            float _top = array.get(ob_bear_top, i)
            float _bot = array.get(ob_bear_bot, i)
            float _ce  = (_top + _bot) / 2.0
            if high[1] >= _ce and high[1] <= _top
                array.set(ob_bear_state, i, FVG_TESTED)
                box.set_border_color(array.get(ob_bear_boxes, i), color.new(#FFD60A, 40))
            else if close[1] > _top
                array.set(ob_bear_state, i, FVG_MITIGATED)
                array.set(ob_bear_mit_bar, i, bar_index)
                box.set_bgcolor(array.get(ob_bear_boxes, i), IN_OB_MIT_COLOR)
                box.set_border_color(array.get(ob_bear_boxes, i), color.new(#636366, 80))
                box.set_right(array.get(ob_bear_boxes, i), bar_index)
                label.set_textcolor(array.get(ob_bear_labels, i), color.new(#636366, 50))
        else if st == FVG_TESTED
            float _top = array.get(ob_bear_top, i)
            if close[1] > _top
                array.set(ob_bear_state, i, FVG_MITIGATED)
                array.set(ob_bear_mit_bar, i, bar_index)
                box.set_bgcolor(array.get(ob_bear_boxes, i), IN_OB_MIT_COLOR)
                box.set_border_color(array.get(ob_bear_boxes, i), color.new(#636366, 80))
                box.set_right(array.get(ob_bear_boxes, i), bar_index)
                label.set_textcolor(array.get(ob_bear_labels, i), color.new(#636366, 50))

// ── 13B.5 Order Block Expiry ────────────────────────────────
int n_ob_bull_exp = array.size(ob_bull_top)
if n_ob_bull_exp > 0
    for i = n_ob_bull_exp - 1 to 0
        string st = array.get(ob_bull_state, i)
        bool expire = false
        if st == FVG_MITIGATED
            expire := not IN_SHOW_OB_MIT or (bar_index - array.get(ob_bull_mit_bar, i) > IN_OB_MIT_EXPIRY)
        else
            expire := (bar_index - array.get(ob_bull_bar, i) > IN_OB_MAX_AGE)
        if expire
            box.delete(array.remove(ob_bull_boxes, i))
            label.delete(array.remove(ob_bull_labels, i))
            array.remove(ob_bull_top, i)
            array.remove(ob_bull_bot, i)
            array.remove(ob_bull_bar, i)
            array.remove(ob_bull_state, i)
            array.remove(ob_bull_mit_bar, i)

int n_ob_bear_exp = array.size(ob_bear_top)
if n_ob_bear_exp > 0
    for i = n_ob_bear_exp - 1 to 0
        string st = array.get(ob_bear_state, i)
        bool expire = false
        if st == FVG_MITIGATED
            expire := not IN_SHOW_OB_MIT or (bar_index - array.get(ob_bear_mit_bar, i) > IN_OB_MIT_EXPIRY)
        else
            expire := (bar_index - array.get(ob_bear_bar, i) > IN_OB_MAX_AGE)
        if expire
            box.delete(array.remove(ob_bear_boxes, i))
            label.delete(array.remove(ob_bear_labels, i))
            array.remove(ob_bear_top, i)
            array.remove(ob_bear_bot, i)
            array.remove(ob_bear_bar, i)
            array.remove(ob_bear_state, i)
            array.remove(ob_bear_mit_bar, i)

// ── 13B.6 Order Block Position Update ───────────────────────
if barstate.islast
    int n_ob_bull_lbl = array.size(ob_bull_labels)
    if n_ob_bull_lbl > 0
        for i = 0 to n_ob_bull_lbl - 1
            if array.get(ob_bull_state, i) != FVG_MITIGATED
                label.set_x(array.get(ob_bull_labels, i), bar_index + 8)
                box.set_right(array.get(ob_bull_boxes, i), bar_index + 3)
    int n_ob_bear_lbl = array.size(ob_bear_labels)
    if n_ob_bear_lbl > 0
        for i = 0 to n_ob_bear_lbl - 1
            if array.get(ob_bear_state, i) != FVG_MITIGATED
                label.set_x(array.get(ob_bear_labels, i), bar_index + 8)
                box.set_right(array.get(ob_bear_boxes, i), bar_index + 3)

// ============================================================
// SECTION 14 — MARKET STRUCTURE ENGINE  (v2.3.0)
// ============================================================
// Architecture:
//   Uses its own swing detection (separate from Liquidity Engine)
//   to track market structure bias.
//
//   BOS  = Break of Structure  — trend continuation
//   CHoCH = Change of Character — trend reversal
//
//   When price breaks a swing high:
//     Current bias Bearish → CHoCH Bullish (reversal)
//     Current bias Bullish → BOS Bullish (continuation)
//   When price breaks a swing low:
//     Current bias Bullish → CHoCH Bearish (reversal)
//     Current bias Bearish → BOS Bearish (continuation)
//
//   Detection uses high[1]/low[1] + close[1] — no repaint.
//
// Events published:
//   EVT_BOS_BULL, EVT_BOS_BEAR   — continuation signals
//   EVT_CHOCH_BULL, EVT_CHOCH_BEAR — reversal signals
//   STRUCTURE_BIAS — running bias (Bullish/Bearish/—)
// ============================================================

// Volume SMA — computed here (before structure detection) so CHoCH+ can use it
float CONF_VOL_SMA = ta.sma(volume, IN_VOL_LEN)

// ── 14.1 Structure Swing Detection ──────────────────────────
float ms_pivot_high = ta.pivothigh(high, IN_MS_SWING_LB, IN_MS_SWING_LB)
float ms_pivot_low  = ta.pivotlow(low,   IN_MS_SWING_LB, IN_MS_SWING_LB)

// Track the last confirmed swing high and swing low for structure
var float MS_LAST_SH       = na
var int   MS_LAST_SH_BAR   = na
var float MS_LAST_SL       = na
var int   MS_LAST_SL_BAR   = na

// Running structure bias — pre-declared in Section 12 pre-declarations

// Update structure swings when new pivots confirm
if not na(ms_pivot_high)
    MS_LAST_SH     := ms_pivot_high
    MS_LAST_SH_BAR := bar_index - IN_MS_SWING_LB

if not na(ms_pivot_low)
    MS_LAST_SL     := ms_pivot_low
    MS_LAST_SL_BAR := bar_index - IN_MS_SWING_LB

// ── 14.2 Structure Event Variables ──────────────────────────
var bool EVT_BOS_BULL        = false
var bool EVT_BOS_BEAR        = false
var bool EVT_CHOCH_BULL      = false
var bool EVT_CHOCH_BEAR      = false
var bool EVT_CHOCH_PLUS_BULL = false
var bool EVT_CHOCH_PLUS_BEAR = false

EVT_BOS_BULL        := false
EVT_BOS_BEAR        := false
EVT_CHOCH_BULL      := false
EVT_CHOCH_BEAR      := false
EVT_CHOCH_PLUS_BULL := false
EVT_CHOCH_PLUS_BEAR := false

// ── 14.3 Structure Break Arrays ─────────────────────────────
// Each break stores: type, direction, price, swing bar, break bar, line, label
var array<string> ms_type       = array.new<string>()   // "BOS" or "CHoCH"
var array<string> ms_dir        = array.new<string>()   // "Bull" or "Bear"
var array<float>  ms_price      = array.new<float>()    // swing price that was broken
var array<int>    ms_swing_bar  = array.new<int>()      // bar of the swing point
var array<int>    ms_break_bar  = array.new<int>()      // bar where break confirmed
var array<line>   ms_lines      = array.new<line>()
var array<label>  ms_labels     = array.new<label>()

// ── 14.4 FIFO Capacity Helper ───────────────────────────────
ms_evict() =>
    if array.size(ms_type) > IN_MS_MAX_LINES
        line.delete(array.shift(ms_lines))
        label.delete(array.shift(ms_labels))
        array.shift(ms_type)
        array.shift(ms_dir)
        array.shift(ms_price)
        array.shift(ms_swing_bar)
        array.shift(ms_break_bar)

// ── 14.5 Bullish Structure Break Detection ──────────────────
// Price breaks above the last swing high on previous bar (no repaint)
bool ms_bull_break = not na(MS_LAST_SH) and not na(high[1]) and high[1] > MS_LAST_SH and close[1] > MS_LAST_SH

if ms_bull_break
    bool is_choch = STRUCTURE_BIAS == MS_BIAS_BEAR or STRUCTURE_BIAS == MS_BIAS_NONE
    // CHoCH+ detection: displacement candle (large body + volume spike)
    float _body1 = math.abs(close[1] - open[1])
    float _range1 = high[1] - low[1]
    bool _disp = is_choch and IN_SHOW_CHOCH_PLUS and _range1 > 0 and (_body1 / _range1) >= IN_CHOCH_DISP_PCT and volume[1] > CONF_VOL_SMA * IN_VOL_MULT
    string break_type = _disp ? MS_CHOCH_PLUS : (is_choch ? MS_CHOCH : MS_BOS)

    // Draw visuals if enabled
    if IN_SHOW_MS
        bool should_show = (is_choch and IN_SHOW_CHOCH) or (not is_choch and IN_SHOW_BOS)
        if should_show
            color bull_clr = _disp ? IN_CHOCH_PLUS_CLR : (is_choch ? IN_CHOCH_BULL_CLR : IN_BOS_BULL_CLR)
            int   ln_width = _disp ? 3 : (is_choch ? 2 : 1)
            string ln_style_str = (is_choch or _disp) ? line.style_solid : line.style_dashed

            line ms_ln = line.new(
                 x1 = MS_LAST_SH_BAR, y1 = MS_LAST_SH,
                 x2 = bar_index - 1,  y2 = MS_LAST_SH,
                 color = bull_clr, width = ln_width, style = ln_style_str)

            label ms_lb = label.new(
                 x = int(math.avg(MS_LAST_SH_BAR, bar_index - 1)),
                 y = MS_LAST_SH,
                 text = break_type,
                 color = COLOR_NONE,
                 textcolor = bull_clr,
                 style = label.style_label_down,
                 size = _disp ? size.normal : (is_choch ? size.small : size.tiny))

            array.push(ms_type,      break_type)
            array.push(ms_dir,       "Bull")
            array.push(ms_price,     MS_LAST_SH)
            array.push(ms_swing_bar, MS_LAST_SH_BAR)
            array.push(ms_break_bar, bar_index - 1)
            array.push(ms_lines,    ms_ln)
            array.push(ms_labels,   ms_lb)
            ms_evict()

    // Always update bias + fire event (even if visuals off)
    STRUCTURE_BIAS := MS_BIAS_BULL
    if _disp
        EVT_CHOCH_PLUS_BULL := true
        EVT_CHOCH_BULL      := true
    else if is_choch
        EVT_CHOCH_BULL := true
    else
        EVT_BOS_BULL := true

    // Invalidate broken swing — force new swing detection
    MS_LAST_SH     := na
    MS_LAST_SH_BAR := na

// ── 14.6 Bearish Structure Break Detection ──────────────────
bool ms_bear_break = not na(MS_LAST_SL) and not na(low[1]) and low[1] < MS_LAST_SL and close[1] < MS_LAST_SL

if ms_bear_break
    bool is_choch = STRUCTURE_BIAS == MS_BIAS_BULL or STRUCTURE_BIAS == MS_BIAS_NONE
    float _body2 = math.abs(close[1] - open[1])
    float _range2 = high[1] - low[1]
    bool _disp2 = is_choch and IN_SHOW_CHOCH_PLUS and _range2 > 0 and (_body2 / _range2) >= IN_CHOCH_DISP_PCT and volume[1] > CONF_VOL_SMA * IN_VOL_MULT
    string break_type = _disp2 ? MS_CHOCH_PLUS : (is_choch ? MS_CHOCH : MS_BOS)

    if IN_SHOW_MS
        bool should_show = (is_choch and IN_SHOW_CHOCH) or (not is_choch and IN_SHOW_BOS)
        if should_show
            color bear_clr = _disp2 ? IN_CHOCH_PLUS_CLR : (is_choch ? color.new(#FF6B6B, 20) : color.new(#FF3B30, 30))
            int   ln_width = _disp2 ? 3 : (is_choch ? 2 : 1)
            string ln_style_str = (is_choch or _disp2) ? line.style_solid : line.style_dashed

            line ms_ln = line.new(
                 x1 = MS_LAST_SL_BAR, y1 = MS_LAST_SL,
                 x2 = bar_index - 1,  y2 = MS_LAST_SL,
                 color = bear_clr, width = ln_width, style = ln_style_str)

            label ms_lb = label.new(
                 x = int(math.avg(MS_LAST_SL_BAR, bar_index - 1)),
                 y = MS_LAST_SL,
                 text = break_type,
                 color = COLOR_NONE,
                 textcolor = bear_clr,
                 style = label.style_label_up,
                 size = _disp2 ? size.normal : (is_choch ? size.small : size.tiny))

            array.push(ms_type,      break_type)
            array.push(ms_dir,       "Bear")
            array.push(ms_price,     MS_LAST_SL)
            array.push(ms_swing_bar, MS_LAST_SL_BAR)
            array.push(ms_break_bar, bar_index - 1)
            array.push(ms_lines,    ms_ln)
            array.push(ms_labels,   ms_lb)
            ms_evict()

    STRUCTURE_BIAS := MS_BIAS_BEAR
    if _disp2
        EVT_CHOCH_PLUS_BEAR := true
        EVT_CHOCH_BEAR      := true
    else if is_choch
        EVT_CHOCH_BEAR := true
    else
        EVT_BOS_BEAR := true

    MS_LAST_SL     := na
    MS_LAST_SL_BAR := na

// ── 14.7 Structure Line Expiry ──────────────────────────────
// Remove old lines after 100 bars to keep chart clean
int n_ms_exp = array.size(ms_break_bar)
if n_ms_exp > 0
    for i = n_ms_exp - 1 to 0
        if bar_index - array.get(ms_break_bar, i) > 100
            line.delete(array.get(ms_lines, i))
            label.delete(array.get(ms_labels, i))
            array.remove(ms_lines, i)
            array.remove(ms_labels, i)
            array.remove(ms_type, i)
            array.remove(ms_dir, i)
            array.remove(ms_price, i)
            array.remove(ms_swing_bar, i)
            array.remove(ms_break_bar, i)

// ── 14.8 Counter-Trend FVG Purge (v2.7.0) ───────────────────
// When structure flips bearish → delete all bullish FVGs (they're now invalid)
// When structure flips bullish → delete all bearish FVGs
// Only purge on CHoCH (real reversal), not BOS (continuation)

if EVT_CHOCH_BEAR
    // Structure flipped bearish — purge all bullish FVGs
    int n_purge = array.size(fvg_bull_top)
    if n_purge > 0
        for i = n_purge - 1 to 0
            box.delete(array.remove(fvg_bull_boxes, i))
            line.delete(array.remove(fvg_bull_ce_lines, i))
            label.delete(array.remove(fvg_bull_labels, i))
            array.remove(fvg_bull_top, i)
            array.remove(fvg_bull_bot, i)
            array.remove(fvg_bull_ce, i)
            array.remove(fvg_bull_bar, i)
            array.remove(fvg_bull_state, i)
            array.remove(fvg_bull_grade, i)
            array.remove(fvg_bull_mit_bar, i)
            array.remove(fvg_bull_post_sweep, i)

if EVT_CHOCH_BULL
    // Structure flipped bullish — purge all bearish FVGs
    int n_purge = array.size(fvg_bear_top)
    if n_purge > 0
        for i = n_purge - 1 to 0
            box.delete(array.remove(fvg_bear_boxes, i))
            line.delete(array.remove(fvg_bear_ce_lines, i))
            label.delete(array.remove(fvg_bear_labels, i))
            array.remove(fvg_bear_top, i)
            array.remove(fvg_bear_bot, i)
            array.remove(fvg_bear_ce, i)
            array.remove(fvg_bear_bar, i)
            array.remove(fvg_bear_state, i)
            array.remove(fvg_bear_grade, i)
            array.remove(fvg_bear_mit_bar, i)
            array.remove(fvg_bear_post_sweep, i)
// ============================================================
// OTE = Optimal Trade Entry (ICT concept)
// Institutions reload positions in the 62–79% retracement zone
// after a swing move. A setup whose FVG CE falls inside the OTE
// zone is significantly higher probability.
//
// Swing detection:
//   Bearish bias → last swing high to last swing low = the measured move
//                → pullback up into 62–79% = OTE for shorts
//   Bullish bias → last swing low to last swing high = the measured move
//                → pullback down into 62–79% = OTE for longs
//
// Key Fibonacci levels used:
//   0.618 (61.8%) — start of OTE zone
//   0.705 (70.5%) — midpoint / ideal entry
//   0.786 (78.6%) — end of OTE zone
// ============================================================

// ── 14.8.1 OTE Zone Calculation ──────────────────────────────
// We track the last confirmed swing high AND swing low together
// to compute the retracement zone for the current structure bias.

var float OTE_HIGH     = na
var float OTE_LOW      = na
var float OTE_705      = na
var bool  OTE_BEAR     = false
var bool  OTE_BULL     = false
var box   OTE_BOX      = na

// ── OTE Zone Calculation ─────────────────────────────────────
// Simple approach that matches what a trader does manually:
// Find the highest high and lowest low in recent structure,
// then compute 50–78.6% retracement zone.
//
// Uses ta.highest/ta.lowest over the MS swing lookback * 4
// to capture the actual swing, not micro pivots.

// Adaptive lookback — higher timeframes need more bars to capture
// a meaningful swing. Multiplier scales with TF so the OTE zone
// uses the same real-time depth regardless of chart resolution.
//   1m/3m/5m : ×16  (default 5×16 = 80 bars)
//   15m/30m  : ×12  (5×12 = 60 bars)
//   1H/4H    : ×8   (5×8  = 40 bars — original default, fine for intraday)
//   Daily+   : ×6   (5×6  = 30 bars — daily bars cover weeks of structure)
int _ote_tf_mult = timeframe.isminutes and timeframe.multiplier <= 5  ? 16 :
                   timeframe.isminutes and timeframe.multiplier <= 30 ? 12 :
                   timeframe.isminutes                                ? 8  :
                   timeframe.isdaily or timeframe.isweekly            ? 6  : 8
int ote_lookback = IN_MS_SWING_LB * _ote_tf_mult

float ote_recent_high = ta.highest(high, ote_lookback)
float ote_recent_low  = ta.lowest(low,   ote_lookback)

// Find WHEN the high and low occurred
int ote_high_bar = ta.highestbars(high, ote_lookback)  // negative offset — 0 = current bar, -5 = 5 bars ago
int ote_low_bar  = ta.lowestbars(low,   ote_lookback)

float ote_range = ote_recent_high - ote_recent_low

if ote_range > 0
    if STRUCTURE_BIAS == MS_BIAS_BEAR and ote_high_bar < ote_low_bar
        // Bearish: high came BEFORE low (price dropped) — OTE for shorts on pullback up
        // 50–70.5% retracement from low back toward high
        OTE_LOW  := ote_recent_low + ote_range * 0.500
        OTE_HIGH := ote_recent_low + ote_range * 0.705
        OTE_705  := ote_recent_low + ote_range * 0.618
        OTE_BEAR := true
        OTE_BULL := false

    else if STRUCTURE_BIAS == MS_BIAS_BULL and ote_low_bar < ote_high_bar
        // Bullish: low came BEFORE high (price rose) — OTE for longs on pullback down
        // Fib measured from swing HIGH downward:
        //   50.0% retrace from high  → top of OTE zone   (entry zone starts here)
        //   61.8% retrace from high  → OTE_705 midpoint  (ideal entry)
        //   70.5% retrace from high  → bottom of OTE zone (zone ends here)
        // Price must pull back INTO the zone (lower than swing high) to be OTE.
        // OTE_HIGH > OTE_LOW is always true (HIGH = 50% retrace, LOW = 70.5% retrace).
        OTE_HIGH := ote_recent_high - ote_range * 0.500
        OTE_LOW  := ote_recent_high - ote_range * 0.705
        OTE_705  := ote_recent_high - ote_range * 0.618  // 61.8% ideal entry
        OTE_BULL := true
        OTE_BEAR := false

    else
        OTE_HIGH := na
        OTE_LOW  := na
        OTE_705  := na
        OTE_BEAR := false
        OTE_BULL := false
else
    OTE_HIGH := na
    OTE_LOW  := na
    OTE_705  := na
    OTE_BEAR := false
    OTE_BULL := false

// ── 14.8.2 OTE Price Check ───────────────────────────────────
bool IN_OTE_ZONE = not na(OTE_HIGH) and not na(OTE_LOW) and
     close >= OTE_LOW and close <= OTE_HIGH

// FVG CE inside OTE zone — check best FVG CE against zone
bool FVG_CE_IN_OTE = false
if not na(OTE_HIGH) and not na(OTE_LOW)
    if STRUCTURE_BIAS == MS_BIAS_BEAR
        int n_fvg_ote = array.size(fvg_bear_ce)
        if n_fvg_ote > 0
            for i = 0 to n_fvg_ote - 1
                if array.get(fvg_bear_state, i) != FVG_MITIGATED and
                     array.get(fvg_bear_state, i) != FVG_DEEP_RETEST
                    float _ce = array.get(fvg_bear_ce, i)
                    if _ce >= OTE_LOW and _ce <= OTE_HIGH
                        FVG_CE_IN_OTE := true
                        break
    else if STRUCTURE_BIAS == MS_BIAS_BULL
        int n_fvg_ote = array.size(fvg_bull_ce)
        if n_fvg_ote > 0
            for i = 0 to n_fvg_ote - 1
                if array.get(fvg_bull_state, i) != FVG_MITIGATED and
                     array.get(fvg_bull_state, i) != FVG_DEEP_RETEST
                    float _ce = array.get(fvg_bull_ce, i)
                    if _ce >= OTE_LOW and _ce <= OTE_HIGH
                        FVG_CE_IN_OTE := true
                        break

// ── 14.8.3 OTE Visual Box ────────────────────────────────────
// Draw/update OTE zone box — compact, right-side only, purple
color _ote_clr    = color.new(#BF5AF2, 92)
color _ote_border = color.new(#BF5AF2, 40)

if not na(OTE_HIGH) and not na(OTE_LOW) and barstate.islast
    box.delete(OTE_BOX)
    OTE_BOX := box.new(
         left         = bar_index - 5,
         top          = OTE_HIGH,
         right        = bar_index + 20,
         bottom       = OTE_LOW,
         bgcolor      = _ote_clr,
         border_color = _ote_border,
         border_width = 1,
         text         = (OTE_BULL ? "OTE ▲  " : "OTE ▼  ") + str.tostring(OTE_LOW, format.mintick) + "–" + str.tostring(OTE_HIGH, format.mintick),
         text_color   = color.new(#BF5AF2, 10),
         text_size    = size.small,
         text_halign  = text.align_right,
         text_valign  = text.align_top)

// ============================================================
// SECTION 15 — CONFLUENCE SCORING ENGINE  (v2.4.0)
// ============================================================
// Architecture:
//   Calculates separate bull and bear scores by consuming all
//   upstream event variables + indicator readings.
//   Generates a signal when score >= threshold.
//
//   Indicators computed here (no extra chart clutter):
//     RSI(14) — overbought/oversold + divergence
//     Volume SMA(20) — spike detection
//     VWAP — session-anchored institutional benchmark
//
//   Score weights are hardcoded for consistency.
//   Only the threshold is user-configurable.
// ============================================================

// ── 15.1 Indicator Calculations ─────────────────────────────

// RSI
float CONF_RSI = ta.rsi(close, IN_RSI_LEN)
bool  rsi_ob   = CONF_RSI >= IN_RSI_OB
bool  rsi_os   = CONF_RSI <= IN_RSI_OS

// RSI Divergence (simple: price makes new low but RSI makes higher low → bullish)
float rsi_low_5  = ta.lowest(CONF_RSI, 10)
float price_low_5 = ta.lowest(low, 10)
bool  rsi_bull_div = low[1] <= price_low_5[1] and CONF_RSI > rsi_low_5
bool  rsi_bear_div = high[1] >= ta.highest(high, 10)[1] and CONF_RSI < ta.highest(CONF_RSI, 10)

// Volume (CONF_VOL_SMA defined earlier in Section 14 for CHoCH+ access)
float CONF_VOL     = volume
bool  vol_spike    = CONF_VOL > CONF_VOL_SMA * IN_VOL_MULT

// VWAP — session-anchored
var float vwap_cum_vol   = 0.0
var float vwap_cum_tp_vol = 0.0
bool  new_session = ta.change(time("D")) != 0
if new_session
    vwap_cum_vol    := 0.0
    vwap_cum_tp_vol := 0.0
float tp = (high + low + close) / 3.0
vwap_cum_vol    += volume
vwap_cum_tp_vol += tp * volume
float CONF_VWAP = vwap_cum_vol > 0 ? vwap_cum_tp_vol / vwap_cum_vol : close

// Plot VWAP if enabled (subtle, no clutter)
plot(IN_SHOW_VWAP ? CONF_VWAP : na, title = "VWAP", color = color.new(#AB47BC, 40),
     linewidth = 1, style = plot.style_line)

// ── 15.2 Event Lookback Helpers ─────────────────────────────
// Check if an event happened within the lookback window

// Sweep events (check recent bars)
bool recent_bsl_sweep = false
bool recent_ssl_sweep = false
for lb = 1 to IN_CONF_LOOKBACK
    if bar_index - lb >= 0
        if EVT_BSL_SWEPT[lb]
            recent_bsl_sweep := true
        if EVT_SSL_SWEPT[lb]
            recent_ssl_sweep := true

// Structure events (check recent bars)
bool recent_bos_bull        = false
bool recent_bos_bear        = false
bool recent_choch_bull      = false
bool recent_choch_bear      = false
bool recent_choch_plus_bull = false
bool recent_choch_plus_bear = false
for lb = 1 to IN_CONF_LOOKBACK
    if bar_index - lb >= 0
        if EVT_BOS_BULL[lb]
            recent_bos_bull := true
        if EVT_BOS_BEAR[lb]
            recent_bos_bear := true
        if EVT_CHOCH_BULL[lb]
            recent_choch_bull := true
        if EVT_CHOCH_BEAR[lb]
            recent_choch_bear := true
        if EVT_CHOCH_PLUS_BULL[lb]
            recent_choch_plus_bull := true
        if EVT_CHOCH_PLUS_BEAR[lb]
            recent_choch_plus_bear := true

// FVG alignment — state-aware (v2.7.0)
// Fresh/First Touch: base points. CE Touch: premium. Deep Retest: degraded. Mitigated: skip.
bool fvg_bull_active      = false
bool fvg_bull_ps          = false
bool fvg_bull_ce_touch    = false  // ideal entry state
bool fvg_bull_deep_retest = false  // degraded state
int n_fb_conf = array.size(fvg_bull_state)
if n_fb_conf > 0
    for i = 0 to n_fb_conf - 1
        string fb_st = array.get(fvg_bull_state, i)
        if fb_st != FVG_MITIGATED
            fvg_bull_active := true
            if array.get(fvg_bull_post_sweep, i)
                fvg_bull_ps := true
            if fb_st == FVG_CE_TOUCH
                fvg_bull_ce_touch := true
            if fb_st == FVG_DEEP_RETEST
                fvg_bull_deep_retest := true

bool fvg_bear_active      = false
bool fvg_bear_ps          = false
bool fvg_bear_ce_touch    = false
bool fvg_bear_deep_retest = false
int n_fbe_conf = array.size(fvg_bear_state)
if n_fbe_conf > 0
    for i = 0 to n_fbe_conf - 1
        string fbe_st = array.get(fvg_bear_state, i)
        if fbe_st != FVG_MITIGATED
            fvg_bear_active := true
            if array.get(fvg_bear_post_sweep, i)
                fvg_bear_ps := true
            if fbe_st == FVG_CE_TOUCH
                fvg_bear_ce_touch := true
            if fbe_st == FVG_DEEP_RETEST
                fvg_bear_deep_retest := true

// Recent sweep grades for scoring
bool recent_bsl_sweep_a = false
bool recent_bsl_sweep_b = false
bool recent_ssl_sweep_a = false
bool recent_ssl_sweep_b = false

// ── 15.3 Score Calculation (v3.1.0 — rescaled 0–100) ────────
// Core ICT   (~50 pts max): Sweep A=9/B=7/C=4, FVG CE=7/Fresh=5/Deep=2, post-sweep=3
//                            CHoCH=7, CHoCH+=4, BOS=4
// HTF align  (~25 pts max): HTF bias=6, HTF FVG CE=7/active=4, HTF OB=6
// Quality    (~15 pts max): PDH/PDL swept=5, Kill zone=4, OTE FVG CE=5/price=3, News=5
// Supporting (~10 pts max): Structure bias=4, Inducement=3, Rejection=4,
//                            OB LTF=3, RSI=3, Volume=3, VWAP=2, Session=2, Context=2

int bull_score = 0
int bear_score = 0

// Sweep — grade-based scoring (v3.1.0: A=9, B=7, C=4)
// SSL sweep = bullish setup, BSL sweep = bearish setup
if recent_ssl_sweep
    bull_score += LAST_SSL_GRADE == SWEEP_A ? 9 : LAST_SSL_GRADE == SWEEP_B ? 7 : 4
if recent_bsl_sweep
    bear_score += LAST_BSL_GRADE == SWEEP_A ? 9 : LAST_BSL_GRADE == SWEEP_B ? 7 : 4

// FVG — state-aware scoring (v3.1.0: CE Touch=7, Fresh/First=5, Deep Retest=2, post-sweep=3)
// CE Touch is the prime entry state. Deep Retest is degraded.
if fvg_bull_active
    bull_score += fvg_bull_ce_touch ? 7 : fvg_bull_deep_retest ? 2 : 5
    if fvg_bull_ps
        bull_score += 3
if fvg_bear_active
    bear_score += fvg_bear_ce_touch ? 7 : fvg_bear_deep_retest ? 2 : 5
    if fvg_bear_ps
        bear_score += 3

// Structure BOS (+4)
if recent_bos_bull
    bull_score += 4
if recent_bos_bear
    bear_score += 4

// Structure CHOCH (+7) — reversal signal, high weight
// CHoCH+ bonus (+4) — displacement break with volume spike
if recent_choch_bull
    bull_score += 7
    if recent_choch_plus_bull
        bull_score += 4
if recent_choch_bear
    bear_score += 7
    if recent_choch_plus_bear
        bear_score += 4

// Structure bias alignment (+4)
if STRUCTURE_BIAS == MS_BIAS_BULL
    bull_score += 4
if STRUCTURE_BIAS == MS_BIAS_BEAR
    bear_score += 4

// HTF structure alignment (+6)  — v3.0.0: real HTF swing bias, not EMA proxy
if HTF_BIAS == HTF_BIAS_BULL
    bull_score += 6
if HTF_BIAS == HTF_BIAS_BEAR
    bear_score += 6

// Active session (+2) — base points for being in any session
if ACTIVE_SESSION != SES_NONE
    bull_score += 2
    bear_score += 2

// Kill Zone bonus (+4) — London/NY/India open = highest institutional flow
// Setup during kill zone is significantly higher probability
if IN_KILL_ZONE
    bull_score += 4
    bear_score += 4

// Context — PDH/PDL alignment (+2)
if MARKET_CONTEXT == CTX_ABOVE
    bull_score += 2
if MARKET_CONTEXT == CTX_BELOW
    bear_score += 2

// PDH/PDL sweep bonus (+5) — sweep of a daily level is the cleanest ICT setup
// Significantly higher quality than a mid-range swing sweep
if PDL_SWEPT
    bull_score += 5
if PDH_SWEPT
    bear_score += 5

// Inducement bonus (+3) — double-sweep pattern = institutional trap
// Two sweeps on the same side within a short window means the second sweep
// is the real move, not a false break
if INDU_SSL_ACTIVE
    bull_score += 3
if INDU_BSL_ACTIVE
    bear_score += 3

// RSI (+3) — OS/divergence for bull, OB/divergence for bear
if rsi_os or rsi_bull_div
    bull_score += 3
if rsi_ob or rsi_bear_div
    bear_score += 3

// Volume spike (+3) — only if candle direction confirms
if vol_spike
    if close[1] > open[1]
        bull_score += 3
    if close[1] < open[1]
        bear_score += 3

// VWAP alignment (+2)
if close > CONF_VWAP
    bull_score += 2
if close < CONF_VWAP
    bear_score += 2

// News sweep bonus (+5) — sweep during news window is highest quality
// A liquidity grab during EIA/API release has institutional backing
if NEWS_POST
    if NEWS_SWEEP_BULL and recent_ssl_sweep
        bull_score += 5
    if NEWS_SWEEP_BEAR and recent_bsl_sweep
        bear_score += 5

// Pre-positioning confirmation bonus (+8) — v3.1.0
// HTF+structure bias captured in pre-news window confirmed by post-news sweep.
// This is the highest-conviction news trade setup — direction was telegraphed
// before the release, then confirmed by the institutional liquidity sweep after.
if NEWS_PREPOS_CONF
    if NEWS_PREPOS_DIR == "Bull"
        bull_score += 8
    else if NEWS_PREPOS_DIR == "Bear"
        bear_score += 8

// Order Block proximity (+10) — price near a fresh/tested OB in signal direction
bool ob_bull_near = false
if array.size(ob_bull_top) > 0
    for i = 0 to array.size(ob_bull_top) - 1
        if array.get(ob_bull_state, i) != FVG_MITIGATED
            float _top = array.get(ob_bull_top, i)
            float _bot = array.get(ob_bull_bot, i)
            float _range = _top - _bot
            if low <= _top + _range * 0.5 and low >= _bot - _range * 0.5
                ob_bull_near := true
                break
if ob_bull_near
    bull_score += 3

bool ob_bear_near = false
if array.size(ob_bear_top) > 0
    for i = 0 to array.size(ob_bear_top) - 1
        if array.get(ob_bear_state, i) != FVG_MITIGATED
            float _top = array.get(ob_bear_top, i)
            float _bot = array.get(ob_bear_bot, i)
            float _range = _top - _bot
            if high >= _bot - _range * 0.5 and high <= _top + _range * 0.5
                ob_bear_near := true
                break
if ob_bear_near
    bear_score += 3

// HTF FVG confluence (+7 CE near, +4 active) — v3.0.0
// When price is near the CE of a higher-timeframe FVG, this is the
// highest-quality entry location in the ICT framework.
if HTF_FVG_BULL_ACTIVE
    bull_score += HTF_FVG_BULL_CE_NEAR ? 7 : 4
if HTF_FVG_BEAR_ACTIVE
    bear_score += HTF_FVG_BEAR_CE_NEAR ? 7 : 4

// HTF Order Block confluence (+6) — v3.0.0
// Price touching an HTF OB zone is an institutional defence area.
// Adds significant weight — HTF OBs are the origin of major moves.
if HTF_OB_BULL_NEAR
    bull_score += 6
if HTF_OB_BEAR_NEAR
    bear_score += 6

// Fibonacci OTE Zone (+3 price in zone, +5 FVG CE in zone)
// OTE = 61.8–78.6% retracement — institutional reload zone
if IN_OTE_ZONE
    if STRUCTURE_BIAS == MS_BIAS_BULL
        bull_score += 3
    if STRUCTURE_BIAS == MS_BIAS_BEAR
        bear_score += 3

if FVG_CE_IN_OTE
    if STRUCTURE_BIAS == MS_BIAS_BULL
        bull_score += 5
    if STRUCTURE_BIAS == MS_BIAS_BEAR
        bear_score += 5

// Rejection candle confirmation (+10) — bar[1] shows wick rejection
// Bull rejection: long lower wick (buyers defended), body in upper half
// Bear rejection: long upper wick (sellers defended), body in upper half of range
float _rej_body  = math.abs(close[1] - open[1])
float _rej_range = high[1] - low[1]
bool _rej_bull = _rej_range > 0 and
     (close[1] > open[1]) and
     (close[1] - low[1]) > _rej_range * 0.6    // lower wick > 60% of range = strong rejection
bool _rej_bear = _rej_range > 0 and
     (close[1] < open[1]) and
     (high[1] - close[1]) > _rej_range * 0.6   // upper wick > 60% of range

if _rej_bull and STRUCTURE_BIAS == MS_BIAS_BULL
    bull_score += 4
if _rej_bear and STRUCTURE_BIAS == MS_BIAS_BEAR
    bear_score += 4

// ── 15.4 Signal Generation ──────────────────────────────────

int  conf_score = math.max(bull_score, bear_score)
string conf_dir = bull_score > bear_score ? "Bull" : bear_score > bull_score ? "Bear" : "—"
bool conf_signal_bull = bull_score >= IN_CONF_THRESHOLD and bull_score > bear_score
bool conf_signal_bear = bear_score >= IN_CONF_THRESHOLD and bear_score > bull_score

// Star rating (v3.1.0 — rescaled 0–100)
int conf_stars = conf_score >= 70 ? 5 :
     conf_score >= 55 ? 4 :
     conf_score >= 40 ? 3 :
     conf_score >= 25 ? 2 :
     conf_score >= 12 ? 1 : 0

string star_display = conf_stars == 5 ? "★★★★★" :
     conf_stars == 4 ? "★★★★☆" :
     conf_stars == 3 ? "★★★☆☆" :
     conf_stars == 2 ? "★★☆☆☆" :
     conf_stars == 1 ? "★☆☆☆☆" : "—"

// Event variables for downstream (Trade Engine)
var bool EVT_SIGNAL_BULL = false
var bool EVT_SIGNAL_BEAR = false
EVT_SIGNAL_BULL := false
EVT_SIGNAL_BEAR := false

// ── 15.4b Score-Gated Alert Booleans (v3.1.0) ───────────────
// These are the "qualified" versions of raw events — only fire when
// the current confluence score meets the alert minimum threshold.
// Suppresses low-quality raw event noise during weak market conditions.
//
// ALT_SWEEP_BULL / BEAR — sweep + score (best sweep alert)
// ALT_CE_BULL / BEAR    — FVG CE touch + score (prime entry)
// ALT_CHOCH_BULL / BEAR — CHoCH + score (high-conviction reversal)
// ALT_PREPOS_BULL / BEAR — pre-positioning confirmation (news setup)

bool alt_score_ok_bull = bull_score >= IN_ALERT_MIN_SCORE
bool alt_score_ok_bear = bear_score >= IN_ALERT_MIN_SCORE

// Qualified Sweep — sweep event fired AND score is high enough
bool ALT_SWEEP_BULL = EVT_SSL_SWEPT and alt_score_ok_bull
bool ALT_SWEEP_BEAR = EVT_BSL_SWEPT and alt_score_ok_bear

// Qualified CE Touch — FVG CE touch AND score qualifies
bool ALT_CE_BULL = EVT_FVG_BULL_CE_TOUCH and alt_score_ok_bull
bool ALT_CE_BEAR = EVT_FVG_BEAR_CE_TOUCH and alt_score_ok_bear

// Qualified CHoCH — CHoCH fired AND score qualifies
bool ALT_CHOCH_BULL = (EVT_CHOCH_BULL or EVT_CHOCH_PLUS_BULL) and alt_score_ok_bull
bool ALT_CHOCH_BEAR = (EVT_CHOCH_BEAR or EVT_CHOCH_PLUS_BEAR) and alt_score_ok_bear

// Pre-positioning confirmation — news direction confirmed by post-news sweep
bool ALT_PREPOS_BULL = NEWS_PREPOS_CONF and NEWS_PREPOS_DIR == "Bull" and alt_score_ok_bull
bool ALT_PREPOS_BEAR = NEWS_PREPOS_CONF and NEWS_PREPOS_DIR == "Bear" and alt_score_ok_bear

// ── 15.5 Signal Markers ─────────────────────────────────────
// Cooldown: suppress signal marker if another fired within last 3 bars
var int last_bull_signal_bar = -10
var int last_bear_signal_bar = -10

bool show_bull_signal = conf_signal_bull and (bar_index - last_bull_signal_bar) >= 3
     and (STRUCTURE_BIAS == MS_BIAS_BULL or STRUCTURE_BIAS == MS_BIAS_NONE)
bool show_bear_signal = conf_signal_bear and (bar_index - last_bear_signal_bar) >= 3
     and (STRUCTURE_BIAS == MS_BIAS_BEAR or STRUCTURE_BIAS == MS_BIAS_NONE)

if show_bull_signal
    last_bull_signal_bar := bar_index
    EVT_SIGNAL_BULL := true
if show_bear_signal
    last_bear_signal_bar := bar_index
    EVT_SIGNAL_BEAR := true

plotshape(IN_SHOW_SIGNALS and show_bull_signal ? low : na,
     title = "Bull Signal", style = shape.diamond, location = location.belowbar,
     color = IN_SIG_BULL_CLR, size = size.tiny)

plotshape(IN_SHOW_SIGNALS and show_bear_signal ? high : na,
     title = "Bear Signal", style = shape.diamond, location = location.abovebar,
     color = IN_SIG_BEAR_CLR, size = size.tiny)

// ── 15.6 Score Overlay ──────────────────────────────────────
var array<label> score_ovl_labels = array.new<label>()

if IN_SHOW_SCORE_OVL and show_bull_signal
    color _sc_tc = conf_score >= 70 ? color.new(#00E676, 0) :
         conf_score >= 55 ? color.new(#00C087, 0) :
         color.new(#00C087, 30)
    label _sl = label.new(bar_index, low,
         text = str.tostring(conf_score),
         color = COLOR_NONE, textcolor = _sc_tc,
         style = label.style_none, size = size.small)
    array.push(score_ovl_labels, _sl)
    if array.size(score_ovl_labels) > 5
        label.delete(array.shift(score_ovl_labels))

if IN_SHOW_SCORE_OVL and show_bear_signal
    color _sc_tc2 = conf_score >= 70 ? color.new(#FF1744, 0) :
         conf_score >= 55 ? color.new(#FF3B30, 0) :
         color.new(#FF3B30, 30)
    label _sl2 = label.new(bar_index, high,
         text = str.tostring(conf_score),
         color = COLOR_NONE, textcolor = _sc_tc2,
         style = label.style_none, size = size.small)
    array.push(score_ovl_labels, _sl2)
    if array.size(score_ovl_labels) > 5
        label.delete(array.shift(score_ovl_labels))

// ============================================================
// SECTION 16 — SETUP LIFECYCLE ENGINE  (v2.6.0)
// ============================================================
// Architecture:
//   Score creates a SETUP (pending), NOT an immediate trade.
//   Setup waits for price to reach FVG CE before activating.
//   At CE touch, conditions are revalidated (ENTRY_SCORE).
//   If still valid → TRADE_ACTIVE. If deteriorated → INVALIDATED.
//
//   State machine:
//     SETUP_NONE → SETUP_PENDING → TRADE_ACTIVE → TRADE_TP1_HIT
//     SETUP_PENDING can exit to: SETUP_EXPIRED, SETUP_INVALIDATED
//     TRADE_ACTIVE can exit to: TRADE_SL_HIT, TRADE_TP1_HIT
//     TRADE_TP1_HIT: SL moves to entry (breakeven)
//       exits to: TRADE_TP2_HIT (full win), TRADE_BE_HIT (partial win)
//
//   SL Candidate Ranking (all must pass correct-side validation):
//     1. FVG boundary (structural invalidation)
//     2. Swept liquidity level
//     3. Nearest unswept liquidity
//     4. ATR fallback (entry ± 1.5×ATR)
//   Risk must be between IN_MIN_RISK_ATR and IN_MAX_SL_ATR × ATR.
//
//   Two scores: SETUP_SCORE (at creation), ENTRY_SCORE (at CE touch).
//   Retest trades use the same pipeline — no separate scoring.
//
//   Visuals: Pending = dashed lines (cyan), Active = solid lines.
//   No repaint: all detections use [1], [2] bar references.
// ============================================================

// ── 16.1 Setup + Trade State Variables ─────────────────────

var string TRADE_STATE     = SETUP_NONE
var string TRADE_DIR       = "—"       // "Bull" or "Bear"
var float  TRADE_ENTRY     = na        // planned entry (FVG CE)
var float  TRADE_SL        = na
var float  TRADE_TP1       = na
var float  TRADE_TP2       = na
var float  TRADE_RISK      = na        // |entry - SL|
var float  TRADE_RR        = na
var int    TRADE_BAR       = 0         // bar when setup created
var int    TRADE_ACTIVATE_BAR = 0      // bar when trade activated (CE touched)

// Two-score model
var int    SETUP_SCORE_VAL = 0         // score at setup creation
var int    ENTRY_SCORE_VAL = 0         // score at CE touch (revalidation)

// FVG tracking for invalidation
var float  SETUP_FVG_BOT   = na        // FVG boundary for SL / invalidation
var float  SETUP_FVG_TOP   = na
var int    SETUP_FVG_IDX   = -1        // index into FVG arrays

// Visual objects — one set active at a time
var line   TRADE_LN_ENTRY  = na
var line   TRADE_LN_SL     = na
var line   TRADE_LN_TP1    = na
var line   TRADE_LN_TP2    = na
var box    TRADE_BX_RISK   = na
var box    TRADE_BX_REWARD = na
var label  TRADE_LBL_ENTRY = na
var label  TRADE_LBL_SL    = na
var label  TRADE_LBL_TP1   = na
var label  TRADE_LBL_TP2   = na

// Event variables for alerts (reset every bar)
var bool EVT_SETUP_CREATED  = false
var bool EVT_TRADE_OPEN     = false
var bool EVT_TRADE_TP1      = false
var bool EVT_TRADE_TP2      = false
var bool EVT_TRADE_SL       = false
var bool EVT_TRADE_BE       = false
var bool EVT_SETUP_EXPIRED  = false
var bool EVT_SETUP_INVALID  = false

EVT_SETUP_CREATED := false
EVT_TRADE_OPEN    := false
EVT_TRADE_TP1     := false
EVT_TRADE_TP2     := false
EVT_TRADE_SL      := false
EVT_TRADE_BE      := false
EVT_SETUP_EXPIRED := false
EVT_SETUP_INVALID := false

// ── 16.2 Helper: Find Best FVG for Entry ───────────────────
// Returns [CE, bot, top, array_index] for nearest active FVG

fn_best_bull_fvg() =>
    // v2.7.0: Skip Deep Retest FVGs — opportunity has passed
    float best_ce = na
    float best_bot = na
    float best_top = na
    int   best_idx = -1
    float best_dist = na
    int n = array.size(fvg_bull_ce)
    if n > 0
        for i = 0 to n - 1
            string _st = array.get(fvg_bull_state, i)
            if _st != FVG_MITIGATED and _st != FVG_DEEP_RETEST
                float ce = array.get(fvg_bull_ce, i)
                float dist = math.abs(close[1] - ce)
                if na(best_dist) or dist < best_dist
                    best_dist := dist
                    best_ce  := ce
                    best_bot := array.get(fvg_bull_bot, i)
                    best_top := array.get(fvg_bull_top, i)
                    best_idx := i
    [best_ce, best_bot, best_top, best_idx]

fn_best_bear_fvg() =>
    // v2.7.0: Skip Deep Retest FVGs — opportunity has passed
    float best_ce = na
    float best_bot = na
    float best_top = na
    int   best_idx = -1
    float best_dist = na
    int n = array.size(fvg_bear_ce)
    if n > 0
        for i = 0 to n - 1
            string _st = array.get(fvg_bear_state, i)
            if _st != FVG_MITIGATED and _st != FVG_DEEP_RETEST
                float ce = array.get(fvg_bear_ce, i)
                float dist = math.abs(close[1] - ce)
                if na(best_dist) or dist < best_dist
                    best_dist := dist
                    best_ce  := ce
                    best_bot := array.get(fvg_bear_bot, i)
                    best_top := array.get(fvg_bear_top, i)
                    best_idx := i
    [best_ce, best_bot, best_top, best_idx]

// ── 16.3 Helper: Ranked SL Selection ───────────────────────
// Generates candidates, filters by correct side, returns best.
// For LONG: SL must be < entry.  For SHORT: SL must be > entry.

fn_find_sl_bull(float entry, float fvg_bot, float sl_buf) =>
    float best = na
    // Candidate 1: FVG boundary (structural invalidation)
    float c1 = not na(fvg_bot) ? fvg_bot - sl_buf : na
    if not na(c1) and c1 < entry
        best := c1
    // Candidate 2: swept SSL (liquidity taken by THIS setup's sweep)
    if na(best)
        int n_sw = array.size(ssl_price)
        if n_sw > 0
            for i = 0 to n_sw - 1
                if array.get(ssl_swept, i)
                    float p = array.get(ssl_price, i) - sl_buf
                    if p < entry
                        if na(best) or p > best  // closest to entry
                            best := p
    // Candidate 3: nearest unswept SSL below entry
    if na(best)
        int n_us = array.size(ssl_price)
        if n_us > 0
            for i = 0 to n_us - 1
                if not array.get(ssl_swept, i)
                    float p = array.get(ssl_price, i) - sl_buf
                    if p < entry
                        if na(best) or p > best
                            best := p
    // Candidate 4: ATR fallback (always valid for long since entry - x < entry)
    if na(best)
        best := entry - ATR_VAL * 1.5
    best

fn_find_sl_bear(float entry, float fvg_top, float sl_buf) =>
    float best = na
    // Candidate 1: FVG boundary
    float c1 = not na(fvg_top) ? fvg_top + sl_buf : na
    if not na(c1) and c1 > entry
        best := c1
    // Candidate 2: swept BSL (liquidity taken by THIS setup's sweep)
    if na(best)
        int n_sw = array.size(bsl_price)
        if n_sw > 0
            for i = 0 to n_sw - 1
                if array.get(bsl_swept, i)
                    float p = array.get(bsl_price, i) + sl_buf
                    if p > entry
                        if na(best) or p < best  // closest to entry
                            best := p
    // Candidate 3: nearest unswept BSL above entry
    if na(best)
        int n_us = array.size(bsl_price)
        if n_us > 0
            for i = 0 to n_us - 1
                if not array.get(bsl_swept, i)
                    float p = array.get(bsl_price, i) + sl_buf
                    if p > entry
                        if na(best) or p < best
                            best := p
    // Candidate 4: ATR fallback
    if na(best)
        best := entry + ATR_VAL * 1.5
    best

// ── 16.4 Clean Up Visuals ──────────────────────────────────

fn_clear_trade_visuals() =>
    line.delete(TRADE_LN_ENTRY)
    line.delete(TRADE_LN_SL)
    line.delete(TRADE_LN_TP1)
    line.delete(TRADE_LN_TP2)
    box.delete(TRADE_BX_RISK)
    box.delete(TRADE_BX_REWARD)
    label.delete(TRADE_LBL_ENTRY)
    label.delete(TRADE_LBL_SL)
    label.delete(TRADE_LBL_TP1)
    label.delete(TRADE_LBL_TP2)

// ── 16.5 Setup Creation — Qualification Gate ───────────────
// Confluence signal → validate → create SETUP_PENDING
// Only one setup at a time. Pending setups cannot be replaced.

float sl_buffer = ATR_VAL * IN_SL_BUFFER_ATR
float min_risk  = ATR_VAL * IN_MIN_RISK_ATR
float max_risk  = ATR_VAL * IN_MAX_SL_ATR

// Only create setup if no active trade and no pending setup
// A pending setup cannot be replaced — it must expire or be invalidated first.
// NEWS_BLOCKED suppresses new setups during pre-news and live windows.
bool can_create_setup = not NEWS_BLOCKED and (TRADE_STATE == SETUP_NONE
     or TRADE_STATE == SETUP_EXPIRED or TRADE_STATE == SETUP_INVALIDATED
     or TRADE_STATE == TRADE_TP2_HIT or TRADE_STATE == TRADE_SL_HIT
     or TRADE_STATE == TRADE_BE_HIT)

// ── Common setup creation pipeline ──────────────────────────
// Both confluence signal and FVG retest flow through this same
// structure: find FVG → qualify → set state → same-bar CE → visuals.

if EVT_SIGNAL_BULL and can_create_setup
    [fvg_ce, fvg_bot, fvg_top, fvg_idx] = fn_best_bull_fvg()
    // No valid FVG → no setup. Do not fall back to close[1].
    if not na(fvg_ce)
        float entry = fvg_ce
        float sl = fn_find_sl_bull(entry, fvg_bot, sl_buffer)
        float risk = math.abs(entry - sl)
        if sl < entry and risk >= min_risk and risk <= max_risk
            fn_clear_trade_visuals()
            TRADE_STATE     := SETUP_PENDING
            TRADE_DIR       := "Bull"
            TRADE_ENTRY     := entry
            TRADE_SL        := sl
            TRADE_TP1       := entry + risk * IN_TRADE_TP1_RR
            TRADE_TP2       := entry + risk * IN_TRADE_TP2_RR
            TRADE_RISK      := risk
            TRADE_RR        := IN_TRADE_TP2_RR
            TRADE_BAR       := bar_index
            SETUP_SCORE_VAL := bull_score
            ENTRY_SCORE_VAL := 0
            SETUP_FVG_BOT   := fvg_bot
            SETUP_FVG_TOP   := fvg_top
            SETUP_FVG_IDX   := fvg_idx
            EVT_SETUP_CREATED := true
            // Same-bar CE check
            if low[1] <= entry
                TRADE_STATE        := TRADE_ACTIVE
                TRADE_ACTIVATE_BAR := bar_index
                ENTRY_SCORE_VAL    := bull_score
                EVT_TRADE_OPEN     := true
            if IN_SHOW_TRADE
                bool _act = TRADE_STATE == TRADE_ACTIVE
                color _ec = _act ? IN_ENTRY_COLOR : IN_PENDING_COLOR
                string _pf = _act ? "ACTIVE " : "PENDING "
                TRADE_LN_ENTRY := line.new(bar_index, entry, bar_index + 20, entry, color = _ec, width = 2, style = _act ? line.style_solid : line.style_dashed)
                TRADE_LN_SL    := line.new(bar_index, sl, bar_index + 20, sl, color = IN_SL_COLOR, width = 2, style = line.style_dashed)
                TRADE_LN_TP1   := line.new(bar_index, TRADE_TP1, bar_index + 20, TRADE_TP1, color = IN_TP_COLOR, width = 2, style = _act ? line.style_dashed : line.style_dotted)
                TRADE_LN_TP2   := line.new(bar_index, TRADE_TP2, bar_index + 20, TRADE_TP2, color = IN_TP_COLOR, width = 2, style = line.style_dotted)
                TRADE_BX_RISK   := box.new(bar_index, entry, bar_index + 20, sl, bgcolor = color.new(IN_SL_COLOR, 75), border_color = color.new(IN_SL_COLOR, 50), border_width = 1)
                TRADE_BX_REWARD := box.new(bar_index, TRADE_TP2, bar_index + 20, entry, bgcolor = color.new(IN_TP_COLOR, 75), border_color = color.new(IN_TP_COLOR, 50), border_width = 1)
                TRADE_LBL_ENTRY := label.new(bar_index + 22, entry, text = _pf + str.tostring(entry, format.mintick), color = COLOR_NONE, textcolor = _ec, style = label.style_label_left, size = size.small)
                TRADE_LBL_SL    := label.new(bar_index + 22, sl, text = "SL " + str.tostring(sl, format.mintick), color = COLOR_NONE, textcolor = IN_SL_COLOR, style = label.style_label_left, size = size.small)
                TRADE_LBL_TP1   := label.new(bar_index + 22, TRADE_TP1, text = "TP1 " + str.tostring(TRADE_TP1, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP1_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)
                TRADE_LBL_TP2   := label.new(bar_index + 22, TRADE_TP2, text = "TP2 " + str.tostring(TRADE_TP2, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP2_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)

if EVT_SIGNAL_BEAR and can_create_setup and not EVT_SETUP_CREATED
    [fvg_ce, fvg_bot, fvg_top, fvg_idx] = fn_best_bear_fvg()
    if not na(fvg_ce)
        float entry = fvg_ce
        float sl = fn_find_sl_bear(entry, fvg_top, sl_buffer)
        float risk = math.abs(sl - entry)
        if sl > entry and risk >= min_risk and risk <= max_risk
            fn_clear_trade_visuals()
            TRADE_STATE     := SETUP_PENDING
            TRADE_DIR       := "Bear"
            TRADE_ENTRY     := entry
            TRADE_SL        := sl
            TRADE_TP1       := entry - risk * IN_TRADE_TP1_RR
            TRADE_TP2       := entry - risk * IN_TRADE_TP2_RR
            TRADE_RISK      := risk
            TRADE_RR        := IN_TRADE_TP2_RR
            TRADE_BAR       := bar_index
            SETUP_SCORE_VAL := bear_score
            ENTRY_SCORE_VAL := 0
            SETUP_FVG_BOT   := fvg_bot
            SETUP_FVG_TOP   := fvg_top
            SETUP_FVG_IDX   := fvg_idx
            EVT_SETUP_CREATED := true
            if high[1] >= entry
                TRADE_STATE        := TRADE_ACTIVE
                TRADE_ACTIVATE_BAR := bar_index
                ENTRY_SCORE_VAL    := bear_score
                EVT_TRADE_OPEN     := true
            if IN_SHOW_TRADE
                bool _act = TRADE_STATE == TRADE_ACTIVE
                color _ec = _act ? IN_ENTRY_COLOR : IN_PENDING_COLOR
                string _pf = _act ? "ACTIVE " : "PENDING "
                TRADE_LN_ENTRY := line.new(bar_index, entry, bar_index + 20, entry, color = _ec, width = 2, style = _act ? line.style_solid : line.style_dashed)
                TRADE_LN_SL    := line.new(bar_index, sl, bar_index + 20, sl, color = IN_SL_COLOR, width = 2, style = line.style_dashed)
                TRADE_LN_TP1   := line.new(bar_index, TRADE_TP1, bar_index + 20, TRADE_TP1, color = IN_TP_COLOR, width = 2, style = _act ? line.style_dashed : line.style_dotted)
                TRADE_LN_TP2   := line.new(bar_index, TRADE_TP2, bar_index + 20, TRADE_TP2, color = IN_TP_COLOR, width = 2, style = line.style_dotted)
                TRADE_BX_RISK   := box.new(bar_index, sl, bar_index + 20, entry, bgcolor = color.new(IN_SL_COLOR, 75), border_color = color.new(IN_SL_COLOR, 50), border_width = 1)
                TRADE_BX_REWARD := box.new(bar_index, entry, bar_index + 20, TRADE_TP2, bgcolor = color.new(IN_TP_COLOR, 75), border_color = color.new(IN_TP_COLOR, 50), border_width = 1)
                TRADE_LBL_ENTRY := label.new(bar_index + 22, entry, text = _pf + str.tostring(entry, format.mintick), color = COLOR_NONE, textcolor = _ec, style = label.style_label_left, size = size.small)
                TRADE_LBL_SL    := label.new(bar_index + 22, sl, text = "SL " + str.tostring(sl, format.mintick), color = COLOR_NONE, textcolor = IN_SL_COLOR, style = label.style_label_left, size = size.small)
                TRADE_LBL_TP1   := label.new(bar_index + 22, TRADE_TP1, text = "TP1 " + str.tostring(TRADE_TP1, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP1_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)
                TRADE_LBL_TP2   := label.new(bar_index + 22, TRADE_TP2, text = "TP2 " + str.tostring(TRADE_TP2, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP2_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)

// ── 16.6 Pending Setup Monitoring ──────────────────────────
// Check: CE touch (→ revalidate → activate), invalidation, expiry

if TRADE_STATE == SETUP_PENDING
    int setup_age = bar_index - TRADE_BAR

    // Check 1: FVG invalidated (mitigated/broken)
    bool fvg_invalid = false
    if TRADE_DIR == "Bull" and SETUP_FVG_IDX >= 0 and SETUP_FVG_IDX < array.size(fvg_bull_state)
        fvg_invalid := array.get(fvg_bull_state, SETUP_FVG_IDX) == FVG_MITIGATED
    else if TRADE_DIR == "Bear" and SETUP_FVG_IDX >= 0 and SETUP_FVG_IDX < array.size(fvg_bear_state)
        fvg_invalid := array.get(fvg_bear_state, SETUP_FVG_IDX) == FVG_MITIGATED

    // Check 2: Structure bias flipped against setup
    bool bias_invalid = false
    if TRADE_DIR == "Bull" and STRUCTURE_BIAS == MS_BIAS_BEAR
        bias_invalid := true
    else if TRADE_DIR == "Bear" and STRUCTURE_BIAS == MS_BIAS_BULL
        bias_invalid := true

    // Check 3: Price reached CE with close confirmation (v2.7.0)
    // Require close inside the FVG zone — not just a wick touch.
    // Bull: low[1] <= CE AND close[1] > FVG bottom (closed inside zone)
    // Bear: high[1] >= CE AND close[1] < FVG top (closed inside zone)
    bool ce_touched = false
    if TRADE_DIR == "Bull"
        ce_touched := low[1] <= TRADE_ENTRY and close[1] > SETUP_FVG_BOT
    else if TRADE_DIR == "Bear"
        ce_touched := high[1] >= TRADE_ENTRY and close[1] < SETUP_FVG_TOP

    // Process: invalidation takes priority, then CE, then expiry
    if fvg_invalid or bias_invalid
        TRADE_STATE := SETUP_INVALIDATED
        EVT_SETUP_INVALID := true
        fn_clear_trade_visuals()

    else if ce_touched
        // Revalidate: compute current score and check minimum
        int current_score = TRADE_DIR == "Bull" ? bull_score : bear_score
        if current_score >= IN_ENTRY_MIN_SCORE
            // ACTIVATE — transition visuals from dashed to solid
            TRADE_STATE       := TRADE_ACTIVE
            TRADE_ACTIVATE_BAR := bar_index
            ENTRY_SCORE_VAL   := current_score
            EVT_TRADE_OPEN    := true
            // Update visuals to solid
            if IN_SHOW_TRADE
                line.set_style(TRADE_LN_ENTRY, line.style_solid)
                line.set_color(TRADE_LN_ENTRY, IN_ENTRY_COLOR)
                line.set_style(TRADE_LN_TP1, line.style_dashed)
                label.set_text(TRADE_LBL_ENTRY, "ACTIVE " + str.tostring(TRADE_ENTRY, format.mintick))
                label.set_textcolor(TRADE_LBL_ENTRY, IN_ENTRY_COLOR)
        else
            // Entry score too low — conditions deteriorated
            TRADE_STATE := SETUP_INVALIDATED
            EVT_SETUP_INVALID := true
            fn_clear_trade_visuals()

    else if setup_age > IN_SETUP_MAX_AGE
        TRADE_STATE := SETUP_EXPIRED
        EVT_SETUP_EXPIRED := true
        fn_clear_trade_visuals()

// ── 16.7 FVG Retest — Same Pipeline ─────────────────────────
// Retest detected → same qualification gate as confluence signal.
// Uses current confluence score. CE check determines PENDING vs ACTIVE.

int RETEST_COOLDOWN = 3
bool cooldown_ok = bar_index - TRADE_BAR > RETEST_COOLDOWN

bool retest_slot_open = not EVT_SIGNAL_BULL and not EVT_SIGNAL_BEAR
     and not EVT_SETUP_CREATED
     and (TRADE_STATE == SETUP_NONE or TRADE_STATE == SETUP_EXPIRED
          or TRADE_STATE == SETUP_INVALIDATED or TRADE_STATE == TRADE_TP2_HIT
          or TRADE_STATE == TRADE_SL_HIT or TRADE_STATE == TRADE_BE_HIT)
     and ACTIVE_SESSION != SES_NONE and cooldown_ok

// Bull FVG retest scan
if retest_slot_open and STRUCTURE_BIAS == MS_BIAS_BULL
    int n_fb_rt = array.size(fvg_bull_state)
    if n_fb_rt > 0
        for i = 0 to n_fb_rt - 1
            string st = array.get(fvg_bull_state, i)
            if st == FVG_FRESH or st == FVG_FIRST_TOUCH or st == FVG_CE_TOUCH
                float bot = array.get(fvg_bull_bot, i)
                float top = array.get(fvg_bull_top, i)
                float ce  = array.get(fvg_bull_ce, i)
                bool entered_zone = low[1] <= top and close[1] >= bot and low[2] > top
                if entered_zone
                    float entry = ce
                    float sl = fn_find_sl_bull(entry, bot, sl_buffer)
                    float risk = math.abs(entry - sl)
                    if sl < entry and risk >= min_risk and risk <= max_risk and bull_score >= IN_ENTRY_MIN_SCORE
                        fn_clear_trade_visuals()
                        bool ce_reached = low[1] <= ce
                        TRADE_STATE     := ce_reached ? TRADE_ACTIVE : SETUP_PENDING
                        TRADE_DIR       := "Bull"
                        TRADE_ENTRY     := entry
                        TRADE_SL        := sl
                        TRADE_TP1       := entry + risk * IN_TRADE_TP1_RR
                        TRADE_TP2       := entry + risk * IN_TRADE_TP2_RR
                        TRADE_RISK      := risk
                        TRADE_RR        := IN_TRADE_TP2_RR
                        TRADE_BAR       := bar_index
                        SETUP_SCORE_VAL := bull_score
                        SETUP_FVG_BOT   := bot
                        SETUP_FVG_TOP   := top
                        SETUP_FVG_IDX   := i
                        if ce_reached
                            TRADE_ACTIVATE_BAR := bar_index
                            ENTRY_SCORE_VAL    := bull_score
                            EVT_TRADE_OPEN     := true
                        else
                            ENTRY_SCORE_VAL    := 0
                            EVT_SETUP_CREATED  := true
                        if IN_SHOW_TRADE
                            color _ec2 = ce_reached ? IN_ENTRY_COLOR : IN_PENDING_COLOR
                            string _pf2 = ce_reached ? "ACTIVE " : "PENDING "
                            TRADE_LN_ENTRY := line.new(bar_index, entry, bar_index + 20, entry, color = _ec2, width = 2, style = ce_reached ? line.style_solid : line.style_dashed)
                            TRADE_LN_SL    := line.new(bar_index, sl, bar_index + 20, sl, color = IN_SL_COLOR, width = 2, style = line.style_dashed)
                            TRADE_LN_TP1   := line.new(bar_index, TRADE_TP1, bar_index + 20, TRADE_TP1, color = IN_TP_COLOR, width = 2, style = ce_reached ? line.style_dashed : line.style_dotted)
                            TRADE_LN_TP2   := line.new(bar_index, TRADE_TP2, bar_index + 20, TRADE_TP2, color = IN_TP_COLOR, width = 2, style = line.style_dotted)
                            TRADE_BX_RISK   := box.new(bar_index, entry, bar_index + 20, sl, bgcolor = color.new(IN_SL_COLOR, 75), border_color = color.new(IN_SL_COLOR, 50), border_width = 1)
                            TRADE_BX_REWARD := box.new(bar_index, TRADE_TP2, bar_index + 20, entry, bgcolor = color.new(IN_TP_COLOR, 75), border_color = color.new(IN_TP_COLOR, 50), border_width = 1)
                            TRADE_LBL_ENTRY := label.new(bar_index + 22, entry, text = _pf2 + str.tostring(entry, format.mintick), color = COLOR_NONE, textcolor = _ec2, style = label.style_label_left, size = size.small)
                            TRADE_LBL_SL    := label.new(bar_index + 22, sl, text = "SL " + str.tostring(sl, format.mintick), color = COLOR_NONE, textcolor = IN_SL_COLOR, style = label.style_label_left, size = size.small)
                            TRADE_LBL_TP1   := label.new(bar_index + 22, TRADE_TP1, text = "TP1 " + str.tostring(TRADE_TP1, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP1_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)
                            TRADE_LBL_TP2   := label.new(bar_index + 22, TRADE_TP2, text = "TP2 " + str.tostring(TRADE_TP2, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP2_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)
                    break

// Bear FVG retest scan
if retest_slot_open and STRUCTURE_BIAS == MS_BIAS_BEAR and not EVT_TRADE_OPEN and not EVT_SETUP_CREATED
    int n_fbe_rt = array.size(fvg_bear_state)
    if n_fbe_rt > 0
        for i = 0 to n_fbe_rt - 1
            string st = array.get(fvg_bear_state, i)
            if st == FVG_FRESH or st == FVG_FIRST_TOUCH or st == FVG_CE_TOUCH
                float bot = array.get(fvg_bear_bot, i)
                float top = array.get(fvg_bear_top, i)
                float ce  = array.get(fvg_bear_ce, i)
                bool entered_zone = high[1] >= bot and close[1] <= top and high[2] < bot
                if entered_zone
                    float entry = ce
                    float sl = fn_find_sl_bear(entry, top, sl_buffer)
                    float risk = math.abs(sl - entry)
                    if sl > entry and risk >= min_risk and risk <= max_risk and bear_score >= IN_ENTRY_MIN_SCORE
                        fn_clear_trade_visuals()
                        bool ce_reached = high[1] >= ce
                        TRADE_STATE     := ce_reached ? TRADE_ACTIVE : SETUP_PENDING
                        TRADE_DIR       := "Bear"
                        TRADE_ENTRY     := entry
                        TRADE_SL        := sl
                        TRADE_TP1       := entry - risk * IN_TRADE_TP1_RR
                        TRADE_TP2       := entry - risk * IN_TRADE_TP2_RR
                        TRADE_RISK      := risk
                        TRADE_RR        := IN_TRADE_TP2_RR
                        TRADE_BAR       := bar_index
                        SETUP_SCORE_VAL := bear_score
                        SETUP_FVG_BOT   := bot
                        SETUP_FVG_TOP   := top
                        SETUP_FVG_IDX   := i
                        if ce_reached
                            TRADE_ACTIVATE_BAR := bar_index
                            ENTRY_SCORE_VAL    := bear_score
                            EVT_TRADE_OPEN     := true
                        else
                            ENTRY_SCORE_VAL    := 0
                            EVT_SETUP_CREATED  := true
                        if IN_SHOW_TRADE
                            color _ec2 = ce_reached ? IN_ENTRY_COLOR : IN_PENDING_COLOR
                            string _pf2 = ce_reached ? "ACTIVE " : "PENDING "
                            TRADE_LN_ENTRY := line.new(bar_index, entry, bar_index + 20, entry, color = _ec2, width = 2, style = ce_reached ? line.style_solid : line.style_dashed)
                            TRADE_LN_SL    := line.new(bar_index, sl, bar_index + 20, sl, color = IN_SL_COLOR, width = 2, style = line.style_dashed)
                            TRADE_LN_TP1   := line.new(bar_index, TRADE_TP1, bar_index + 20, TRADE_TP1, color = IN_TP_COLOR, width = 2, style = ce_reached ? line.style_dashed : line.style_dotted)
                            TRADE_LN_TP2   := line.new(bar_index, TRADE_TP2, bar_index + 20, TRADE_TP2, color = IN_TP_COLOR, width = 2, style = line.style_dotted)
                            TRADE_BX_RISK   := box.new(bar_index, sl, bar_index + 20, entry, bgcolor = color.new(IN_SL_COLOR, 75), border_color = color.new(IN_SL_COLOR, 50), border_width = 1)
                            TRADE_BX_REWARD := box.new(bar_index, entry, bar_index + 20, TRADE_TP2, bgcolor = color.new(IN_TP_COLOR, 75), border_color = color.new(IN_TP_COLOR, 50), border_width = 1)
                            TRADE_LBL_ENTRY := label.new(bar_index + 22, entry, text = _pf2 + str.tostring(entry, format.mintick), color = COLOR_NONE, textcolor = _ec2, style = label.style_label_left, size = size.small)
                            TRADE_LBL_SL    := label.new(bar_index + 22, sl, text = "SL " + str.tostring(sl, format.mintick), color = COLOR_NONE, textcolor = IN_SL_COLOR, style = label.style_label_left, size = size.small)
                            TRADE_LBL_TP1   := label.new(bar_index + 22, TRADE_TP1, text = "TP1 " + str.tostring(TRADE_TP1, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP1_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)
                            TRADE_LBL_TP2   := label.new(bar_index + 22, TRADE_TP2, text = "TP2 " + str.tostring(TRADE_TP2, format.mintick) + "  (1:" + str.tostring(IN_TRADE_TP2_RR, "#.#") + ")", color = COLOR_NONE, textcolor = IN_TP_COLOR, style = label.style_label_left, size = size.small)
                    break

// ── 16.8 Trade Monitoring — SL/TP/BE/Expiry ────────────────
//
// BACKTEST ASSUMPTIONS (documented per architecture review):
//
// 1. SAME-BAR SL/TP AMBIGUITY:
//    If both SL and TP are touched on the same evaluated bar,
//    SL takes priority (conservative assumption). This cannot be
//    resolved without lower-timeframe data. Future enhancement.
//
// 2. INVALIDATION PRIORITY OVER CE TOUCH:
//    In Section 16.6, when CE touch and invalidation (FVG mitigated
//    or structure flip) occur on the same evaluated bar, invalidation
//    wins. This prevents entering a trade where conditions have
//    already deteriorated.

if TRADE_STATE == TRADE_ACTIVE or TRADE_STATE == TRADE_TP1_HIT
    bool hit_sl  = false
    bool hit_tp2 = false
    bool hit_tp1 = false

    if TRADE_DIR == "Bull"
        if TRADE_STATE == TRADE_TP1_HIT
            // After TP1, SL is at breakeven (entry)
            hit_sl  := low[1] <= TRADE_ENTRY
        else
            hit_sl  := low[1] <= TRADE_SL
        hit_tp2 := high[1] >= TRADE_TP2
        hit_tp1 := not hit_tp2 and high[1] >= TRADE_TP1

    else if TRADE_DIR == "Bear"
        if TRADE_STATE == TRADE_TP1_HIT
            hit_sl  := high[1] >= TRADE_ENTRY
        else
            hit_sl  := high[1] >= TRADE_SL
        hit_tp2 := low[1] <= TRADE_TP2
        hit_tp1 := not hit_tp2 and low[1] <= TRADE_TP1

    if hit_sl
        if TRADE_STATE == TRADE_TP1_HIT
            // Breakeven hit after TP1 — partial win
            TRADE_STATE := TRADE_BE_HIT
            EVT_TRADE_BE := true
        else
            TRADE_STATE := TRADE_SL_HIT
            EVT_TRADE_SL := true
        // Trim visuals and release
        line.set_color(TRADE_LN_ENTRY, TRADE_STATE == TRADE_BE_HIT ? COLOR_NEUTRAL : IN_SL_COLOR)
        line.set_x2(TRADE_LN_ENTRY, bar_index)
        line.set_x2(TRADE_LN_SL,    bar_index)
        line.set_x2(TRADE_LN_TP1,   bar_index)
        line.set_x2(TRADE_LN_TP2,   bar_index)
        box.set_right(TRADE_BX_RISK,   bar_index)
        box.set_right(TRADE_BX_REWARD, bar_index)
        label.delete(TRADE_LBL_ENTRY)
        label.delete(TRADE_LBL_SL)
        label.delete(TRADE_LBL_TP1)
        label.delete(TRADE_LBL_TP2)
        TRADE_LN_ENTRY  := na
        TRADE_LN_SL     := na
        TRADE_LN_TP1    := na
        TRADE_LN_TP2    := na
        TRADE_BX_RISK   := na
        TRADE_BX_REWARD := na
        TRADE_LBL_ENTRY := na
        TRADE_LBL_SL    := na
        TRADE_LBL_TP1   := na
        TRADE_LBL_TP2   := na

    else if hit_tp2
        TRADE_STATE := TRADE_TP2_HIT
        EVT_TRADE_TP2 := true
        line.set_color(TRADE_LN_ENTRY, IN_TP_COLOR)
        line.set_x2(TRADE_LN_ENTRY, bar_index)
        line.set_x2(TRADE_LN_SL,    bar_index)
        line.set_x2(TRADE_LN_TP1,   bar_index)
        line.set_x2(TRADE_LN_TP2,   bar_index)
        box.set_right(TRADE_BX_RISK,   bar_index)
        box.set_right(TRADE_BX_REWARD, bar_index)
        label.delete(TRADE_LBL_ENTRY)
        label.delete(TRADE_LBL_SL)
        label.delete(TRADE_LBL_TP1)
        label.delete(TRADE_LBL_TP2)
        TRADE_LN_ENTRY  := na
        TRADE_LN_SL     := na
        TRADE_LN_TP1    := na
        TRADE_LN_TP2    := na
        TRADE_BX_RISK   := na
        TRADE_BX_REWARD := na
        TRADE_LBL_ENTRY := na
        TRADE_LBL_SL    := na
        TRADE_LBL_TP1   := na
        TRADE_LBL_TP2   := na

    else if hit_tp1 and TRADE_STATE == TRADE_ACTIVE
        TRADE_STATE := TRADE_TP1_HIT
        EVT_TRADE_TP1 := true
        // Move SL to breakeven visually
        line.set_color(TRADE_LN_TP1, color.new(#00E676, 0))
        line.set_width(TRADE_LN_TP1, 2)
        // Move SL line to entry (breakeven)
        line.set_y1(TRADE_LN_SL, TRADE_ENTRY)
        line.set_y2(TRADE_LN_SL, TRADE_ENTRY)
        line.set_color(TRADE_LN_SL, COLOR_NEUTRAL)
        line.set_style(TRADE_LN_SL, line.style_solid)
        label.set_y(TRADE_LBL_SL, TRADE_ENTRY)
        label.set_text(TRADE_LBL_SL, "BE " + str.tostring(TRADE_ENTRY, format.mintick))
        label.set_textcolor(TRADE_LBL_SL, COLOR_NEUTRAL)
        // Shrink risk box to zero (entry to entry)
        box.set_top(TRADE_BX_RISK, TRADE_ENTRY)
        box.set_bottom(TRADE_BX_RISK, TRADE_ENTRY)

    // Active trade expiry
    else if bar_index - TRADE_ACTIVATE_BAR > IN_TRADE_MAX_AGE
        TRADE_STATE := SETUP_EXPIRED
        fn_clear_trade_visuals()

// ── 16.9 Visual Position Update ─────────────────────────────

if barstate.islast and IN_SHOW_TRADE
    if TRADE_STATE == SETUP_PENDING or TRADE_STATE == TRADE_ACTIVE or TRADE_STATE == TRADE_TP1_HIT
        int right_edge = bar_index + 5
        int label_x = bar_index + 7
        line.set_x2(TRADE_LN_ENTRY, right_edge)
        line.set_x2(TRADE_LN_SL,    right_edge)
        line.set_x2(TRADE_LN_TP1,   right_edge)
        line.set_x2(TRADE_LN_TP2,   right_edge)
        box.set_right(TRADE_BX_RISK,   right_edge)
        box.set_right(TRADE_BX_REWARD, right_edge)
        label.set_x(TRADE_LBL_ENTRY, label_x)
        label.set_x(TRADE_LBL_SL,    label_x)
        label.set_x(TRADE_LBL_TP1,   label_x)
        label.set_x(TRADE_LBL_TP2,   label_x)

// ============================================================
// SECTION 9 — DASHBOARD ENGINE  (updated for v2.6.0)
// ============================================================

var table DASHBOARD = table.new(
     fn_table_pos(IN_DASH_POS),
     columns = 2, rows = 28,
     bgcolor = COLOR_BG, border_color = COLOR_DIM,
     border_width = 1, frame_color = COLOR_DIM, frame_width = 1)

dash_row(int row, string label_text, string value, color val_color) =>
    table.cell(DASHBOARD, 0, row, text = label_text,
         text_color = COLOR_WHITE, text_size = size.small, bgcolor = COLOR_HEADER,
         text_halign = text.align_left)
    table.cell(DASHBOARD, 1, row, text = value,
         text_color = val_color, text_size = size.small, bgcolor = COLOR_BG)

if IN_SHOW_DASH and barstate.islast
    table.cell(DASHBOARD, 0, 0,
         text = "LSS PRO  " + VERSION, text_color = COLOR_WHITE,
         text_size = size.small, bgcolor = color.new(#0A84FF, 0),
         text_halign = text.align_center)
    table.merge_cells(DASHBOARD, 0, 0, 1, 0)

    string ses_display = IN_KILL_ZONE ? ACTIVE_SESSION + " ★KZ" : ACTIVE_SESSION
    dash_row(1, "Session", ses_display, ACTIVE_SESSION_COLOR)

    // News Calendar row (v2.7.0 / v3.1.0 pre-pos)
    color news_clr = NEWS_PHASE == "Clear" ? COLOR_DIM :
         NEWS_PHASE == "★ Post-News" ? COLOR_BULL :
         COLOR_NEUTRAL
    string prepos_suffix = NEWS_PREPOS_ARMED and not _prepos_post_seen ?
         "  ► " + NEWS_PREPOS_DIR :
         NEWS_PREPOS_CONF ? "  ✓ " + NEWS_PREPOS_DIR : ""
    string news_txt = NEWS_PHASE == "Clear" ? "Clear" :
         NEWS_PHASE + "  " + NEWS_EVENT + prepos_suffix
    dash_row(2, "News", news_txt, news_clr)

    dash_row(3, "HTF",        fn_htf_label(RESOLVED_HTF), COLOR_INFO)
    dash_row(4, "HTF Bias",   HTF_BIAS, HTF_BIAS_COLOR)
    string htf_sh_str = na(HTF_LAST_SH) ? "—" : str.tostring(HTF_LAST_SH, format.mintick)
    string htf_sl_str = na(HTF_LAST_SL) ? "—" : str.tostring(HTF_LAST_SL, format.mintick)
    dash_row(5, "HTF SH/SL",  htf_sh_str + " / " + htf_sl_str, COLOR_DIM)

    // HTF FVG row — show active state + CE proximity
    string htf_fvg_txt =
         HTF_FVG_BULL_CE_NEAR ? "Bull ▲ @ CE" :
         HTF_FVG_BULL_ACTIVE  ? "Bull ▲ Active" :
         HTF_FVG_BEAR_CE_NEAR ? "Bear ▼ @ CE" :
         HTF_FVG_BEAR_ACTIVE  ? "Bear ▼ Active" : "—"
    color htf_fvg_clr =
         HTF_FVG_BULL_CE_NEAR or HTF_FVG_BULL_ACTIVE ? COLOR_BULL :
         HTF_FVG_BEAR_CE_NEAR or HTF_FVG_BEAR_ACTIVE ? COLOR_BEAR :
         COLOR_DIM
    dash_row(6, "HTF FVG", htf_fvg_txt, htf_fvg_clr)

    // HTF OB row
    string htf_ob_txt =
         HTF_OB_BULL_NEAR ? "Bull ▲ In Zone" :
         HTF_OB_BEAR_NEAR ? "Bear ▼ In Zone" :
         HTF_OB_BULL_ACTIVE ? "Bull ▲ Above" :
         HTF_OB_BEAR_ACTIVE ? "Bear ▼ Below" : "—"
    color htf_ob_clr =
         HTF_OB_BULL_NEAR ? COLOR_BULL :
         HTF_OB_BEAR_NEAR ? COLOR_BEAR :
         (HTF_OB_BULL_ACTIVE or HTF_OB_BEAR_ACTIVE) ? COLOR_NEUTRAL :
         COLOR_DIM
    dash_row(7, "HTF OB", htf_ob_txt, htf_ob_clr)
    dash_row(8, "Context",   MARKET_CONTEXT, CONTEXT_COLOR)
    dash_row(9, "PDH / PDL",
         str.tostring(PD_HIGH, format.mintick) + " / " + str.tostring(PD_LOW, format.mintick), COLOR_DIM)

    // Liquidity counts
    int active_bsl = 0
    int sz_bsl = array.size(bsl_swept)
    if sz_bsl > 0
        for i = 0 to sz_bsl - 1
            if not array.get(bsl_swept, i)
                active_bsl += 1
    int active_ssl = 0
    int sz_ssl = array.size(ssl_swept)
    if sz_ssl > 0
        for i = 0 to sz_ssl - 1
            if not array.get(ssl_swept, i)
                active_ssl += 1
    dash_row(10, "Liq Levels",
         "BSL " + str.tostring(active_bsl) + "  │  SSL " + str.tostring(active_ssl), COLOR_DIM)

    color sweep_clr = LIQ_LAST_SWEEP == "—" ? COLOR_DIM :
         str.contains(LIQ_LAST_SWEEP, "BSL") ? IN_BSL_COLOR : IN_SSL_COLOR
    dash_row(11, "Last Sweep", LIQ_LAST_SWEEP, sweep_clr)

    // FVG counts
    int fresh_bull = 0
    int n_fb_dash = array.size(fvg_bull_state)
    if n_fb_dash > 0
        for i = 0 to n_fb_dash - 1
            if array.get(fvg_bull_state, i) != FVG_MITIGATED
                fresh_bull += 1
    int fresh_bear = 0
    int n_fbe_dash = array.size(fvg_bear_state)
    if n_fbe_dash > 0
        for i = 0 to n_fbe_dash - 1
            if array.get(fvg_bear_state, i) != FVG_MITIGATED
                fresh_bear += 1
    dash_row(12, "FVG Active",
         "Bull " + str.tostring(fresh_bull) + "  │  Bear " + str.tostring(fresh_bear),
         fresh_bull > 0 or fresh_bear > 0 ? COLOR_INFO : COLOR_DIM)

    // FVG Quality row (v2.7.0 — shows best active state)
    string fvg_bull_best_state = FVG_FRESH
    bool   fvg_bull_any_active = false
    int n_fb_dash2 = array.size(fvg_bull_state)
    if n_fb_dash2 > 0
        for i = 0 to n_fb_dash2 - 1
            string _s = array.get(fvg_bull_state, i)
            if _s != FVG_MITIGATED
                fvg_bull_any_active := true
                if _s == FVG_CE_TOUCH or _s == FVG_DEEP_RETEST or _s == FVG_FIRST_TOUCH
                    fvg_bull_best_state := _s
    string fvg_bear_best_state = FVG_FRESH
    bool   fvg_bear_any_active = false
    int n_fbe_dash2 = array.size(fvg_bear_state)
    if n_fbe_dash2 > 0
        for i = 0 to n_fbe_dash2 - 1
            string _s = array.get(fvg_bear_state, i)
            if _s != FVG_MITIGATED
                fvg_bear_any_active := true
                if _s == FVG_CE_TOUCH or _s == FVG_DEEP_RETEST or _s == FVG_FIRST_TOUCH
                    fvg_bear_best_state := _s
    string fvg_qual_bull = fvg_bull_any_active ? "B:" + fvg_bull_best_state : "B:—"
    string fvg_qual_bear = fvg_bear_any_active ? "S:" + fvg_bear_best_state : "S:—"
    color  fvg_qual_clr  = (fvg_bull_best_state == FVG_CE_TOUCH and fvg_bull_any_active) or
                           (fvg_bear_best_state == FVG_CE_TOUCH and fvg_bear_any_active) ?
                           COLOR_NEUTRAL :
                           fvg_bull_any_active or fvg_bear_any_active ? COLOR_INFO : COLOR_DIM
    string sweep_grade_txt = "Sw " +
         (LAST_SSL_GRADE == SWEEP_A ? "SSL-A" : LAST_SSL_GRADE == SWEEP_B ? "SSL-B" : "SSL-C") +
         " / " +
         (LAST_BSL_GRADE == SWEEP_A ? "BSL-A" : LAST_BSL_GRADE == SWEEP_B ? "BSL-B" : "BSL-C")
    dash_row(13, "FVG Quality", fvg_qual_bull + "  │  " + fvg_qual_bear, fvg_qual_clr)

    // Order Blocks
    int active_ob_bull = 0
    int n_ob_b_dash = array.size(ob_bull_state)
    if n_ob_b_dash > 0
        for i = 0 to n_ob_b_dash - 1
            if array.get(ob_bull_state, i) != FVG_MITIGATED
                active_ob_bull += 1
    int active_ob_bear = 0
    int n_ob_be_dash = array.size(ob_bear_state)
    if n_ob_be_dash > 0
        for i = 0 to n_ob_be_dash - 1
            if array.get(ob_bear_state, i) != FVG_MITIGATED
                active_ob_bear += 1
    dash_row(14, "OB Active",
         "Bull " + str.tostring(active_ob_bull) + "  │  Bear " + str.tostring(active_ob_bear),
         active_ob_bull > 0 or active_ob_bear > 0 ? COLOR_INFO : COLOR_DIM)

    // Market Structure (NEW in v2.3.0)
    color ms_bias_clr = STRUCTURE_BIAS == MS_BIAS_BULL ? COLOR_BULL :
         STRUCTURE_BIAS == MS_BIAS_BEAR ? COLOR_BEAR : COLOR_DIM
    dash_row(15, "Structure", STRUCTURE_BIAS, ms_bias_clr)

    // Last structure break
    string ms_last_break = "—"
    color  ms_last_clr   = COLOR_DIM
    int n_ms_dash = array.size(ms_type)
    if n_ms_dash > 0
        string lt = array.get(ms_type, n_ms_dash - 1)
        string ld = array.get(ms_dir, n_ms_dash - 1)
        ms_last_break := lt + " " + ld
        ms_last_clr := ld == "Bull" ? COLOR_BULL : COLOR_BEAR
    dash_row(16, "Last Break", ms_last_break, ms_last_clr)

    // Confluence Scoring (NEW in v2.4.0)
    color score_clr = conf_score >= 101 ? color.new(#00E676, 0) :
         conf_score >= 81  ? COLOR_BULL :
         conf_score >= 61  ? COLOR_INFO :
         conf_score >= 41  ? COLOR_NEUTRAL :
         COLOR_DIM
    dash_row(17, "Score",
         str.tostring(conf_score) + " / 100  " + star_display, score_clr)

    // OTE Zone row (v2.7.0)
    string ote_txt = na(OTE_HIGH) or na(OTE_LOW) ? "—" :
         str.tostring(OTE_LOW, format.mintick) + " – " + str.tostring(OTE_HIGH, format.mintick) +
         (IN_OTE_ZONE ? " ★IN" : "") + (FVG_CE_IN_OTE ? " FVG✓" : "")
    color ote_clr = FVG_CE_IN_OTE ? COLOR_NEUTRAL :
         IN_OTE_ZONE ? COLOR_INFO : COLOR_DIM
    dash_row(18, "OTE Zone", ote_txt, ote_clr)

    color sig_clr = conf_dir == "Bull" ? COLOR_BULL : conf_dir == "Bear" ? COLOR_BEAR : COLOR_DIM
    string sig_text = conf_signal_bull ? "▲ BULL SETUP" :
         conf_signal_bear ? "▼ BEAR SETUP" : "No Signal"
    dash_row(19, "Signal", sig_text, sig_clr)

    dash_row(20, "RSI", str.tostring(CONF_RSI, "#.#") +
         (rsi_ob ? " (OB)" : rsi_os ? " (OS)" : ""), COLOR_INFO)

    // Trade Management (v2.6.0 Setup Lifecycle)
    bool has_setup = TRADE_STATE != SETUP_NONE
    color trade_state_clr = TRADE_STATE == SETUP_PENDING ? IN_PENDING_COLOR :
         TRADE_STATE == TRADE_ACTIVE ? COLOR_BULL :
         TRADE_STATE == TRADE_TP1_HIT ? COLOR_BULL :
         TRADE_STATE == TRADE_TP2_HIT ? color.new(#00E676, 0) :
         TRADE_STATE == TRADE_SL_HIT ? COLOR_BEAR :
         TRADE_STATE == TRADE_BE_HIT ? COLOR_NEUTRAL :
         TRADE_STATE == SETUP_EXPIRED ? COLOR_DIM :
         TRADE_STATE == SETUP_INVALIDATED ? COLOR_BEAR :
         COLOR_DIM
    dash_row(21, "Trade", TRADE_STATE, trade_state_clr)

    string trade_dir_text = TRADE_DIR == "Bull" ? "▲ LONG" : TRADE_DIR == "Bear" ? "▼ SHORT" : "—"
    color  trade_dir_clr  = TRADE_DIR == "Bull" ? COLOR_BULL : TRADE_DIR == "Bear" ? COLOR_BEAR : COLOR_DIM
    dash_row(22, "Direction", trade_dir_text, trade_dir_clr)

    string entry_text = not na(TRADE_ENTRY) and has_setup ? str.tostring(TRADE_ENTRY, format.mintick) : "—"
    dash_row(23, "Entry", entry_text, TRADE_STATE == SETUP_PENDING ? IN_PENDING_COLOR : IN_ENTRY_COLOR)

    string sl_text = not na(TRADE_SL) and has_setup ?
         str.tostring(TRADE_SL, format.mintick) : "—"
    string tp_text = not na(TRADE_TP1) and has_setup ?
         str.tostring(TRADE_TP1, format.mintick) + " / " + str.tostring(TRADE_TP2, format.mintick) : "—"
    dash_row(24, "SL", sl_text, IN_SL_COLOR)
    dash_row(25, "TP1 / TP2", tp_text, IN_TP_COLOR)

    string rr_text = not na(TRADE_RISK) and has_setup ?
         "1:" + str.tostring(IN_TRADE_TP2_RR, "#.#") + "  Risk " + str.tostring(TRADE_RISK, format.mintick) : "—"
    dash_row(26, "R:R", rr_text, COLOR_INFO)

    // Two-score model: Setup Score (at creation) + Entry Score (at CE)
    string score_s = has_setup ? str.tostring(SETUP_SCORE_VAL) : "—"
    string score_e = ENTRY_SCORE_VAL > 0 ? str.tostring(ENTRY_SCORE_VAL) : "—"
    string scores_text = score_s + " → " + score_e
    color  scores_clr = ENTRY_SCORE_VAL >= IN_ENTRY_MIN_SCORE ? COLOR_BULL :
         SETUP_SCORE_VAL > 0 ? IN_PENDING_COLOR : COLOR_DIM
    dash_row(27, "Setup → Entry", scores_text, scores_clr)

// ============================================================
// SECTION 17 — WIN-RATE TRACKER  (v3.1.0)
// ============================================================
// Architecture:
//   Persistent counters (var) accumulate every closed trade outcome
//   across the full chart history on every bar recalculation.
//   Outcomes: TP2 (full win), TP1+BE (partial win), SL (loss).
//   Displays a compact table with: trades, wins, win%, avg score,
//   total R earned. Positioned independently from main dashboard.
// ============================================================

// ── 17.1 Persistent Counters ────────────────────────────────

var int   WR_TOTAL   = 0     // total closed trades
var int   WR_TP2     = 0     // full wins (TP2 hit)
var int   WR_TP1_BE  = 0     // partial wins (TP1 + breakeven)
var int   WR_SL      = 0     // losses (SL hit)
var float WR_R_TOTAL = 0.0   // cumulative R (TP2=2R, TP1BE=1R, SL=-1R)
var int   WR_SCORE_SUM = 0   // sum of entry scores for avg calculation

// ── 17.2 Outcome Capture ────────────────────────────────────
// Hook into the same EVT_ booleans the alert engine uses.
// These fire on the bar the trade closes.

if EVT_TRADE_TP2
    WR_TOTAL     += 1
    WR_TP2       += 1
    WR_R_TOTAL   += TRADE_RR           // actual TP2 R:R set at creation
    WR_SCORE_SUM += ENTRY_SCORE_VAL

if EVT_TRADE_BE
    WR_TOTAL     += 1
    WR_TP1_BE    += 1
    WR_R_TOTAL   += TRADE_RR * 0.5    // TP1 partial: roughly half the TP2 R
    WR_SCORE_SUM += ENTRY_SCORE_VAL

if EVT_TRADE_SL
    WR_TOTAL     += 1
    WR_SL        += 1
    WR_R_TOTAL   -= 1.0               // always -1R on SL
    WR_SCORE_SUM += ENTRY_SCORE_VAL

// ── 17.3 Computed Metrics ───────────────────────────────────

int   wr_wins     = WR_TP2 + WR_TP1_BE
float wr_pct      = WR_TOTAL > 0 ? (float(wr_wins) / float(WR_TOTAL)) * 100.0 : 0.0
float wr_avg_r    = WR_TOTAL > 0 ? WR_R_TOTAL / float(WR_TOTAL) : 0.0
float wr_avg_score = WR_TOTAL > 0 ? float(WR_SCORE_SUM) / float(WR_TOTAL) : 0.0
float wr_expectancy = wr_pct / 100.0 * wr_avg_r - (1.0 - wr_pct / 100.0)

// ── 17.4 Tracker Table ──────────────────────────────────────

var table WR_TABLE = table.new(
     position    = IN_WR_POS == POS_TL ? position.top_left :
                   IN_WR_POS == POS_TR ? position.top_right :
                   IN_WR_POS == POS_BL ? position.bottom_left :
                                         position.bottom_right,
     columns     = 2,
     rows        = 10,
     bgcolor     = color.new(#1C1C1E, 5),
     border_color = color.new(#3A3A3C, 60),
     border_width = 1,
     frame_color  = color.new(#3A3A3C, 40),
     frame_width  = 1)

if IN_SHOW_WR and barstate.islast

    // Header
    table.cell(WR_TABLE, 0, 0, text = "LSS PRO  TRACKER",
         text_color = COLOR_WHITE, text_size = size.small,
         bgcolor = color.new(#2C2C2E, 0))
    table.merge_cells(WR_TABLE, 0, 0, 1, 0)

    color clr_lbl  = color.new(#8E8E93, 0)
    color clr_val  = COLOR_WHITE
    color clr_win  = color.new(#00E676, 0)
    color clr_loss = color.new(#FF3B30, 0)
    color clr_neut = color.new(#FFCC00, 0)

    table.cell(WR_TABLE, 0, 1, "Trades",             text_color = clr_lbl, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 1, str.tostring(WR_TOTAL), text_color = clr_val, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    table.cell(WR_TABLE, 0, 2, "TP2 (Full)",         text_color = clr_lbl, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 2, str.tostring(WR_TP2), text_color = clr_win, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    table.cell(WR_TABLE, 0, 3, "TP1+BE",               text_color = clr_lbl,  text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 3, str.tostring(WR_TP1_BE), text_color = clr_neut, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    table.cell(WR_TABLE, 0, 4, "SL",               text_color = clr_lbl,  text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 4, str.tostring(WR_SL), text_color = clr_loss, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    color wr_clr = wr_pct >= 60 ? clr_win : wr_pct >= 40 ? clr_neut : clr_loss
    table.cell(WR_TABLE, 0, 5, "Win %",                                             text_color = clr_lbl, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 5, str.tostring(math.round(wr_pct, 1)) + "%",           text_color = wr_clr,  text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    color r_clr = WR_R_TOTAL >= 0 ? clr_win : clr_loss
    table.cell(WR_TABLE, 0, 6, "Total R",                                                                     text_color = clr_lbl, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 6, (WR_R_TOTAL >= 0 ? "+" : "") + str.tostring(math.round(WR_R_TOTAL, 2)) + "R", text_color = r_clr,   text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    color avgr_clr = wr_avg_r >= 0 ? clr_win : clr_loss
    table.cell(WR_TABLE, 0, 7, "Avg R/Trade",                                                               text_color = clr_lbl,  text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 7, (wr_avg_r >= 0 ? "+" : "") + str.tostring(math.round(wr_avg_r, 2)) + "R",   text_color = avgr_clr, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    color exp_clr = wr_expectancy >= 0 ? clr_win : clr_loss
    table.cell(WR_TABLE, 0, 8, "Expectancy",                                                                              text_color = clr_lbl, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 8, (wr_expectancy >= 0 ? "+" : "") + str.tostring(math.round(wr_expectancy, 3)), text_color = exp_clr, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

    table.cell(WR_TABLE, 0, 9, "Avg Score",                                                          text_color = clr_lbl, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))
    table.cell(WR_TABLE, 1, 9, str.tostring(math.round(wr_avg_score, 1)) + " / 100",                text_color = clr_val, text_size = size.small, bgcolor = color.new(#1C1C1E, 5))

// ============================================================
// SECTION 10 — DEBUG ENGINE  (updated for v2.6.0)
// ============================================================

var label DEBUG_LABEL = label.new(bar_index, high, "",
     color = color.new(#1C1C1E, 10), textcolor = COLOR_WHITE,
     style = label.style_label_left, size = size.normal)

if IN_SHOW_DEBUG and barstate.islast
    int dbg_bsl = 0
    int dbg_bsl_sz = array.size(bsl_swept)
    if dbg_bsl_sz > 0
        for i = 0 to dbg_bsl_sz - 1
            if not array.get(bsl_swept, i)
                dbg_bsl += 1
    int dbg_ssl = 0
    int dbg_ssl_sz = array.size(ssl_swept)
    if dbg_ssl_sz > 0
        for i = 0 to dbg_ssl_sz - 1
            if not array.get(ssl_swept, i)
                dbg_ssl += 1

    int dbg_fvg_bull = array.size(fvg_bull_top)
    int dbg_fvg_bear = array.size(fvg_bear_top)

    string dbg = "── LSS Pro Debug ──\n" +
         "Bar        : " + str.tostring(bar_index)          + "\n" +
         "HTF        : " + RESOLVED_HTF                     + "\n" +
         "HTF Bias   : " + HTF_BIAS                                               + "\n" +
         "HTF Last SH: " + (na(HTF_LAST_SH) ? "—" : str.tostring(HTF_LAST_SH, "#.##")) + "\n" +
         "HTF Last SL: " + (na(HTF_LAST_SL) ? "—" : str.tostring(HTF_LAST_SL, "#.##")) + "\n" +
         "HTF FVG B  : " + HTF_FVG_BULL_STATE + (HTF_FVG_BULL_CE_NEAR ? " ★CE" : "") + "\n" +
         "HTF FVG S  : " + HTF_FVG_BEAR_STATE + (HTF_FVG_BEAR_CE_NEAR ? " ★CE" : "") + "\n" +
         "HTF OB Bull: " + (HTF_OB_BULL_NEAR ? "In Zone" : HTF_OB_BULL_ACTIVE ? "Active" : "—") + "\n" +
         "HTF OB Bear: " + (HTF_OB_BEAR_NEAR ? "In Zone" : HTF_OB_BEAR_ACTIVE ? "Active" : "—") + "\n" +
         "Session    : " + ACTIVE_SESSION                                        + "\n" +
         "EMA 50     : " + str.tostring(EMA50,  "#.##")                         + "\n" +
         "EMA 200    : " + str.tostring(EMA200, "#.##")                         + "\n" +
         "PDH        : " + str.tostring(PD_HIGH, "#.##")    + "\n" +
         "PDL        : " + str.tostring(PD_LOW,  "#.##")    + "\n" +
         "Context    : " + MARKET_CONTEXT                   + "\n" +
         "─ Liquidity ─\n" +
         "BSL Active : " + str.tostring(dbg_bsl)            + " / 5\n" +
         "SSL Active : " + str.tostring(dbg_ssl)            + " / 5\n" +
         "Last Sweep : " + LIQ_LAST_SWEEP                   + "\n" +
         "─ FVG ─\n" +
         "Bull FVGs  : " + str.tostring(dbg_fvg_bull)       + " / 5\n" +
         "Bear FVGs  : " + str.tostring(dbg_fvg_bear)       + " / 5\n" +
         "ATR(14)    : " + str.tostring(ATR_VAL, "#.##")    + "\n" +
         "Min Width  : " + str.tostring(ATR_VAL * IN_FVG_MIN_ATR, "#.##") + "\n" +
         "─ Structure ─\n" +
         "Bias       : " + STRUCTURE_BIAS                    + "\n" +
         "CHoCH+     : " + (EVT_CHOCH_PLUS_BULL ? "BULL" : EVT_CHOCH_PLUS_BEAR ? "BEAR" : "—") + "\n" +
         "Breaks     : " + str.tostring(array.size(ms_type)) + " / " + str.tostring(IN_MS_MAX_LINES) + "\n" +
         "─ Confluence ─\n" +
         "Bull Score : " + str.tostring(bull_score)           + "\n" +
         "Bear Score : " + str.tostring(bear_score)           + "\n" +
         "Stars      : " + star_display                       + "\n" +
         "RSI        : " + str.tostring(CONF_RSI, "#.#")     + "\n" +
         "Vol Spike  : " + (vol_spike ? "YES" : "no")         + "\n" +
         "VWAP       : " + str.tostring(CONF_VWAP, "#.##")   + "\n" +
         "─ Setup / Trade ─\n" +
         "State      : " + TRADE_STATE                         + "\n" +
         "Direction  : " + TRADE_DIR                           + "\n" +
         "Entry      : " + str.tostring(TRADE_ENTRY, "#.##")  + "\n" +
         "SL         : " + str.tostring(TRADE_SL, "#.##")     + "\n" +
         "TP1        : " + str.tostring(TRADE_TP1, "#.##")    + "\n" +
         "TP2        : " + str.tostring(TRADE_TP2, "#.##")    + "\n" +
         "Setup Score: " + str.tostring(SETUP_SCORE_VAL)       + "\n" +
         "Entry Score: " + str.tostring(ENTRY_SCORE_VAL)       + "\n" +
         "FVG Idx    : " + str.tostring(SETUP_FVG_IDX)

    label.set_xy(DEBUG_LABEL, bar_index + 2, high)
    label.set_text(DEBUG_LABEL, dbg)

if not IN_SHOW_DEBUG
    label.set_text(DEBUG_LABEL, "")

